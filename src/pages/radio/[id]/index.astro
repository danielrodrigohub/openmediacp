---
import '@fontsource-variable/source-sans-3';
import '../../../styles/theme.css';
import Brand from '../../../components/Brand.astro';
import Icon from '../../../components/Icon.astro';
import {
  publicRadio,
  radioDate,
  radioDays,
  radioHour,
  recordingsFor,
  songsForDate,
  syncStationApi,
} from '../../../server/radio';

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
const channel = publicRadio(Astro.params.id);
if (!channel) return new Response('Radio a la carta no disponible.', {
  status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow, noarchive' },
});

const station = await syncStationApi(channel.id, channel.station_api_url);
const stationName = station.name || channel.name;
const liveStreamUrl = station.listen_url || channel.source_url || '';

const recordings = recordingsFor(channel.id);
const days = radioDays();
const requested = Astro.url.searchParams.get('fecha');
const date = requested && days.includes(requested) ? requested : days[0];
const selections = recordings.filter(item => radioDate(item.start) === date);
const songs = songsForDate(channel.id, date, selections, station.now_playing?.played_at);

const capitalizeFirst = (value: string) => value ? value.charAt(0).toUpperCase() + value.slice(1) : '';
const dateFormat = new Intl.DateTimeFormat('es-CL', {
  timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long',
});
const calendarDay = (day: string) => new Date(day + 'T12:00:00Z');
const dateLabel = (day: string) => capitalizeFirst(dateFormat.format(calendarDay(day)));
const shortDate = new Intl.DateTimeFormat('es-CL', { timeZone: 'UTC', weekday: 'short', day: 'numeric' });
const shortLabel = (day: string) => capitalizeFirst(shortDate.format(calendarDay(day)).replace(/\./g, ''));
const timeRange = (start: number, end: number) => `${radioHour(start)} – ${radioHour(end)}`;
const durationMinutes = (start: number, end: number) => {
  const mins = Math.max(1, Math.round((end - start) / 60_000));
  return `${mins} min`;
};
const formatSongDuration = (seconds: number) => {
  if (!seconds || seconds <= 0) return '—';
  const mins = Math.floor(seconds / 60);
  const secs = Math.floor(seconds % 60).toString().padStart(2, '0');
  return `${mins}:${secs}`;
};
const radioPath = `/radio/${channel.id}/`;
const nowPlayingText = station.now_playing
  ? `${station.now_playing.artist ? station.now_playing.artist + ' — ' : ''}${station.now_playing.title}`
  : 'Señal en directo';
const nowPlayingArt = station.now_playing?.art || '';
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow, noarchive"/>
  <title>{stationName} · Radio a la carta</title>
</head>
<body class="shared-player-page" data-radio-path={radioPath} data-station-name={stationName} data-live-url={liveStreamUrl}>
  <header class="radio-header">
    <Brand/>
    <div class="radio-identity">
      <strong id="header-station-name">{stationName} a la Carta</strong>
      <small>Escucha las emisiones de {stationName}</small>
    </div>
    <nav aria-label="Navegación principal">
      <a href="#inicio" class="is-active">Inicio</a>
      <a href="#programas">Programas</a>
      <a href="#grabaciones">Grabaciones</a>
      <a href="#canciones">Canciones</a>
    </nav>
    <label class="radio-search">
      <Icon name="search" size={17}/>
      <input type="search" id="recording-search" placeholder="Buscar horario" aria-label="Buscar grabación por horario"/>
    </label>
  </header>

  <main class="radio-page">
    <h1 class="sr-only">{stationName} a la Carta</h1>
    <div class="radio-layout">
      <section class="card explorer" id="programas">
        <div class="card-heading">
          <div>
            <h2>Explora la programación</h2>
            <p class="hint">Selecciona un día y escucha las emisiones.</p>
          </div>
        </div>
        <div class="card-body">
          <div class="date-controls">
            <button class="button icon-step" id="previous-day" type="button" aria-label="Día anterior">‹</button>
            <label class="date-picker">
              <Icon name="calendar" size={18}/>
              <span class="sr-only">Elegir fecha</span>
              <input type="date" id="radio-date" value={date} min={days[days.length - 1]} max={days[0]}/>
            </label>
            <button class="button icon-step" id="next-day" type="button" aria-label="Día siguiente">›</button>
          </div>

          <nav class="radio-days" aria-label="Fecha de la grabación">
            {days.map((day, index) => (
              <a
                href={`${radioPath}?fecha=${day}`}
                aria-label={index === 0 ? 'Hoy, ' + dateLabel(day) : dateLabel(day)}
                aria-current={day === date ? 'page' : undefined}
                class:list={['button', 'day-button', day === date ? 'primary' : '']}
              >
                <strong>{index === 0 ? 'Hoy' : shortLabel(day)}</strong>
              </a>
            ))}
          </nav>

          <div class="recording-day-heading">
            <h3>{dateLabel(date)}</h3>
            <span>{selections.length} {selections.length === 1 ? 'corte disponible' : 'cortes disponibles'}</span>
          </div>

          {selections.length ? (
            <ul class="radio-hours">
              {selections.map(item => (
                <li>
                  <button
                    type="button"
                    class="button recording-row"
                    data-radio-audio={radioPath + item.name}
                    data-radio-name={item.name}
                    data-radio-start={item.start}
                    data-radio-end={item.end}
                    data-radio-time={timeRange(item.start, item.end)}
                    data-radio-date={dateLabel(date)}
                    aria-pressed="false"
                  >
                    <span class="segment-icon"><Icon name="play" size={17}/></span>
                    <span class="segment-meta">
                      <strong>Grabación</strong>
                      <small>{timeRange(item.start, item.end)} hrs.</small>
                    </span>
                    <span class="row-play" aria-hidden="true">▶</span>
                  </button>
                </li>
              ))}
            </ul>
          ) : (
            <p class="hint">Todavía no hay grabaciones disponibles para esta fecha.</p>
          )}
        </div>
      </section>

      <div class="radio-content">
        <section class="player-panel" id="inicio" aria-labelledby="player-title">
          <div class="player-art" id="player-art-box">
            <img
              id="player-art-img"
              src={nowPlayingArt || undefined}
              alt={`Carátula de ${stationName}`}
              hidden={!nowPlayingArt}
              loading="eager"
            />
            <span id="player-art-fallback" class="player-art-icon" hidden={Boolean(nowPlayingArt)} aria-hidden="true">
              <Icon name="broadcast" size={50}/>
            </span>
          </div>

          <div class="player-main">
            <div class="player-top">
              <span class="mode-badge" id="play-state">En directo</span>
              <button id="go-live" type="button" class="go-live-btn">
                <Icon name="broadcast" size={17}/>
                <span>Volver al directo</span>
              </button>
            </div>

            <h2 id="player-title">{stationName}</h2>
            <p id="radio-selection" class="player-subtitle" aria-live="polite" data-live-text={nowPlayingText}>
              {nowPlayingText}
            </p>

            <audio id="radio-audio" aria-label="Reproductor de grabaciones" preload="metadata"></audio>
            <audio id="radio-live" aria-label="Escuchar en directo" preload="auto" src={liveStreamUrl}></audio>

            <div class="custom-controls">
              <button id="skip-back" type="button" class="skip-btn" aria-label="Retroceder 15 segundos" title="Retroceder 15 segundos">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M3 12a9 9 0 1 0 3-6.7L3 8"/>
                  <path d="M3 3v5h5"/>
                  <text x="12" y="15.5" text-anchor="middle" font-size="7.5" font-weight="700" fill="currentColor" stroke="none">15</text>
                </svg>
              </button>

              <button id="toggle-play" type="button" class="play-btn" aria-label="Reproducir">
                <svg class="icon-play" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <polygon points="8,5 20,12 8,19"/>
                </svg>
                <svg class="icon-pause" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" hidden>
                  <rect x="6.5" y="5" width="4" height="14" rx="1"/>
                  <rect x="13.5" y="5" width="4" height="14" rx="1"/>
                </svg>
              </button>

              <button id="skip-forward" type="button" class="skip-btn" aria-label="Avanzar 15 segundos" title="Avanzar 15 segundos">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M21 12a9 9 0 1 1-3-6.7L21 8"/>
                  <path d="M21 3v5h-5"/>
                  <text x="12" y="15.5" text-anchor="middle" font-size="7.5" font-weight="700" fill="currentColor" stroke="none">15</text>
                </svg>
              </button>

              <output id="play-time">En directo</output>

              <input
                id="play-progress"
                type="range"
                min="0"
                max="100"
                step="0.1"
                value="50"
                aria-label="Posición de reproducción"
              />

              <div class="volume-control">
                <button id="mute-toggle" type="button" class="icon-only-btn" aria-label="Silenciar o activar sonido">
                  <span id="vol-icon-on"><Icon name="volume" size={18}/></span>
                  <span id="vol-icon-mute" hidden><Icon name="mute" size={18}/></span>
                </button>
                <input id="play-volume" type="range" min="0" max="1" step="0.05" value="1" aria-label="Volumen"/>
              </div>

              <button id="share-recording" type="button" class="icon-only-btn" aria-label="Compartir grabación" title="Copiar enlace">
                <Icon name="external" size={18}/>
              </button>
            </div>

            <p id="radio-error" class="player-error" role="status" hidden>
              No se pudo cargar el audio. Selecciona el horario para volver a intentarlo.
            </p>
          </div>
        </section>

        <section class="card" id="grabaciones">
          <div class="card-heading">
            <h2>Grabaciones del día</h2>
            <span class="hint">Archivos por hora</span>
          </div>
          <div class="recording-chips">
            {selections.map(item => (
              <button
                class="button"
                type="button"
                data-chip={radioPath + item.name}
                data-chip-name={item.name}
                aria-pressed="false"
              >
                <Icon name="play" size={15}/>
                {timeRange(item.start, item.end)}
              </button>
            ))}
            {!selections.length && <p class="hint">Aún no hay archivos disponibles.</p>}
          </div>
        </section>

        <section class="card songs-panel" id="canciones">
          <div class="card-heading">
            <h2>Horario de canciones</h2>
            <span class="hint">Sincronizado con la estación y grabaciones</span>
          </div>
          <div class="card-body songs-table-wrap">
            <table id="songs-table">
              <thead>
                <tr>
                  <th>Hora</th>
                  <th>Canción</th>
                  <th>Artista</th>
                  <th>Duración</th>
                  <th>Archivo</th>
                </tr>
              </thead>
              <tbody id="songs-tbody">
                {songs.length ? songs.map(song => (
                  <tr
                    data-song-row
                    data-has-recording={song.recording ? 'true' : 'false'}
                    data-recording-name={song.recording?.name || ''}
                    data-played-at={song.played_at}
                  >
                    <td class="song-time-cell">
                      <strong>{radioHour(song.played_at * 1000)}</strong>
                      {song.is_current && <span class="song-live-pill">Ahora</span>}
                    </td>
                    <td>
                      <div class="song-title-cell">
                        {song.art && <img src={song.art} alt="" class="song-thumb" loading="lazy"/>}
                        <strong>{song.title}</strong>
                      </div>
                    </td>
                    <td>{song.artist || stationName}</td>
                    <td class="song-duration-cell">{formatSongDuration(song.duration)}</td>
                    <td>
                      {song.recording ? (
                        <button
                          type="button"
                          class="button small song-seek-btn"
                          data-seek-audio={radioPath + song.recording.name}
                          data-seek-offset={song.recording.offset}
                          data-seek-title={`${song.artist ? song.artist + ' — ' : ''}${song.title}`}
                          data-seek-art={song.art}
                        >
                          <Icon name="play" size={14}/>
                          <span>{timeRange(song.recording.start, song.recording.end)}</span>
                        </button>
                      ) : song.is_current ? (
                        <button type="button" class="button small song-seek-btn" data-trigger-live="true">
                          <Icon name="broadcast" size={14}/>
                          <span>En directo</span>
                        </button>
                      ) : (
                        <span class="no-archive-tag">Sin corte</span>
                      )}
                    </td>
                  </tr>
                )) : (
                  <tr>
                    <td colspan="5" class="songs-empty-cell">
                      La radio aún no dispone de un registro de canciones emitidas.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </main>

  <footer class="radio-footer">
    <Brand/>
    <span>{stationName} · Radio a la Carta</span>
    <span>Hora de Chile continental</span>
  </footer>

  <nav class="mobile-radio-nav" aria-label="Navegación móvil">
    <a href="#inicio"><Icon name="home"/>Inicio</a>
    <a href="#programas"><Icon name="broadcast"/>Programas</a>
    <a href="#grabaciones"><Icon name="list"/>Grabaciones</a>
    <a href="#radio-date"><Icon name="calendar"/>Calendario</a>
  </nav>

  <script>
    const bodyEl = document.body;
    const radioPath = bodyEl.dataset.radioPath || location.pathname;
    let liveStreamUrl = bodyEl.dataset.liveUrl || '';
    const live = document.querySelector<HTMLAudioElement>('#radio-live')!;
    const audio = document.querySelector<HTMLAudioElement>('#radio-audio')!;
    const selection = document.querySelector<HTMLElement>('#radio-selection')!;
    const error = document.querySelector<HTMLElement>('#radio-error')!;
    const toggle = document.querySelector<HTMLButtonElement>('#toggle-play')!;
    const iconPlay = toggle.querySelector<SVGElement>('.icon-play')!;
    const iconPause = toggle.querySelector<SVGElement>('.icon-pause')!;
    const progress = document.querySelector<HTMLInputElement>('#play-progress')!;
    const playTime = document.querySelector<HTMLElement>('#play-time')!;
    const statusBadge = document.querySelector<HTMLElement>('#play-state')!;
    const goLiveBtn = document.querySelector<HTMLButtonElement>('#go-live')!;
    const artImg = document.querySelector<HTMLImageElement>('#player-art-img')!;
    const artFallback = document.querySelector<HTMLElement>('#player-art-fallback')!;
    const skipBackBtn = document.querySelector<HTMLButtonElement>('#skip-back')!;
    const skipForwardBtn = document.querySelector<HTMLButtonElement>('#skip-forward')!;
    const volumeInput = document.querySelector<HTMLInputElement>('#play-volume')!;
    const muteBtn = document.querySelector<HTMLButtonElement>('#mute-toggle')!;
    const volIconOn = document.querySelector<HTMLElement>('#vol-icon-on')!;
    const volIconMute = document.querySelector<HTMLElement>('#vol-icon-mute')!;

    let choices = [...document.querySelectorAll<HTMLButtonElement>('[data-radio-audio]')];
    let mode: 'live' | 'archive' = 'live';
    let activeIndex = -1;
    let activeStartMs = 0;
    let activeEndMs = 0;
    let activeName = '';
    let pendingSeek: number | null = null;
    let isScrubbing = false;
    let lastVolume = 1;
    let liveTrackTitle = selection.dataset.liveText || 'Señal en directo';
    let liveTrackArt = artImg.getAttribute('src') || '';

    const clock = (seconds: number) =>
      Number.isFinite(seconds) && seconds >= 0
        ? `${Math.floor(seconds / 60)}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`
        : '0:00';

    function getKnownDuration(index = activeIndex): number {
      if (index === activeIndex && Number.isFinite(audio.duration) && audio.duration > 1) {
        return audio.duration;
      }
      const btn = choices[index];
      if (btn) {
        const start = Number(btn.dataset.radioStart) || 0;
        const end = Number(btn.dataset.radioEnd) || 0;
        if (end > start) return (end - start) / 1000;
      }
      if (activeEndMs > activeStartMs) return (activeEndMs - activeStartMs) / 1000;
      return 0;
    }

    function setArtwork(url?: string) {
      if (url) {
        artImg.src = url;
        artImg.hidden = false;
        artFallback.hidden = true;
      } else {
        artImg.removeAttribute('src');
        artImg.hidden = true;
        artFallback.hidden = false;
      }
    }

    artImg.addEventListener('error', () => {
      artImg.hidden = true;
      artFallback.hidden = false;
    });

    function setPlayIcon(playing: boolean) {
      iconPlay.setAttribute('hidden', '');
      iconPause.setAttribute('hidden', '');
      if (playing) {
        iconPause.removeAttribute('hidden');
      } else {
        iconPlay.removeAttribute('hidden');
      }
      toggle.setAttribute('aria-label', playing ? 'Pausar' : 'Reproducir');
    }

    function updatePressedStates(recordingAudioUrl: string | null) {
      choices.forEach(choice => {
        choice.setAttribute('aria-pressed', String(choice.dataset.radioAudio === recordingAudioUrl));
      });
      document.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach(chip => {
        chip.setAttribute('aria-pressed', String(chip.dataset.chip === recordingAudioUrl));
      });
    }

    function switchToPresent(autoPlay = true) {
      mode = 'live';
      activeIndex = -1;
      activeName = '';
      pendingSeek = null;
      audio.pause();
      error.hidden = true;
      statusBadge.textContent = 'En directo';
      selection.textContent = liveTrackTitle;
      setArtwork(liveTrackArt);
      progress.disabled = false;
      progress.value = '50';
      playTime.textContent = 'En directo';
      updatePressedStates(null);

      if (autoPlay && liveStreamUrl) {
        statusBadge.textContent = 'Conectando…';
        if (live.getAttribute('src') !== liveStreamUrl) {
          live.src = liveStreamUrl;
        }
        live.load();
        void live.play().catch(() => {
          setPlayIcon(false);
          statusBadge.textContent = 'En directo';
        });
      } else {
        setPlayIcon(!live.paused);
      }
    }

    function applySeekToAudio(targetSec: number) {
      const dur = getKnownDuration();
      const clamped = dur > 0 ? Math.max(0, Math.min(targetSec, Math.max(0, dur - 0.5))) : Math.max(0, targetSec);
      pendingSeek = clamped;
      try {
        if (audio.readyState >= 1) {
          audio.currentTime = clamped;
          if (Math.abs(audio.currentTime - clamped) <= 2) {
            pendingSeek = null;
          }
        }
      } catch {}
      if (dur > 0) {
        playTime.textContent = `${clock(clamped)} / ${clock(dur)}`;
        progress.value = String(Math.min(100, Math.max(0, (clamped / dur) * 100)));
      }
    }

    function playArchive(index: number, seekOffsetSeconds = 0, customSubtitle?: string, customArt?: string) {
      if (index < 0 || !choices[index]) return;
      const button = choices[index];
      const baseAudioUrl = button.dataset.radioAudio || '';
      if (!baseAudioUrl) return;

      mode = 'archive';
      activeIndex = index;
      activeName = button.dataset.radioName || '';
      activeStartMs = Number(button.dataset.radioStart) || 0;
      activeEndMs = Number(button.dataset.radioEnd) || 0;

      const dur = getKnownDuration(index);
      const targetOffset = dur > 0
        ? Math.max(0, Math.min(seekOffsetSeconds, Math.max(0, dur - 1)))
        : Math.max(0, seekOffsetSeconds);
      pendingSeek = targetOffset;

      live.pause();
      error.hidden = true;
      statusBadge.textContent = 'Grabación disponible';

      const dateText = button.dataset.radioDate || '';
      const rangeText = button.dataset.radioTime || '';
      selection.textContent = customSubtitle
        ? `${customSubtitle} · ${rangeText} hrs.`
        : `${dateText ? dateText + ' · ' : ''}${rangeText} hrs.`;

      setArtwork(customArt || liveTrackArt);
      progress.disabled = false;
      playTime.textContent = `${clock(targetOffset)} / ${clock(dur)}`;
      progress.value = dur > 0 ? String(Math.min(100, Math.max(0, (targetOffset / dur) * 100))) : '0';
      updatePressedStates(baseAudioUrl);

      const currentBase = (audio.getAttribute('src') || '').split('#')[0];
      const sameSrc = currentBase === baseAudioUrl;

      if (sameSrc && audio.readyState >= 1) {
        applySeekToAudio(targetOffset);
        void audio.play().catch(() => {
          if (audio.error) error.hidden = false;
        });
      } else {
        // Use W3C Media Fragment #t= so browser seeks at demuxer level immediately, plus loadedmetadata/canplay fallback
        const fragment = targetOffset > 0 ? `#t=${Math.floor(targetOffset)}` : '';
        audio.src = baseAudioUrl + fragment;
        audio.load();
        const onReady = () => {
          if (pendingSeek !== null) {
            try { audio.currentTime = pendingSeek; } catch {}
          }
          void audio.play().catch(() => {
            if (audio.error) error.hidden = false;
          });
        };
        audio.addEventListener('loadedmetadata', onReady, { once: true });
      }
    }

    audio.addEventListener('canplay', () => {
      if (mode === 'archive' && pendingSeek !== null) {
        const target = pendingSeek;
        pendingSeek = null;
        try {
          if (Math.abs(audio.currentTime - target) > 2) {
            audio.currentTime = target;
          }
        } catch {}
      }
    });

    toggle.addEventListener('click', () => {
      if (mode === 'live') {
        if (live.paused) {
          if (!live.getAttribute('src') && liveStreamUrl) live.src = liveStreamUrl;
          void live.play().catch(() => {
            statusBadge.textContent = 'No se pudo reproducir';
          });
        } else {
          live.pause();
        }
      } else {
        if (audio.paused) {
          void audio.play().catch(() => {
            statusBadge.textContent = 'No se pudo reproducir';
          });
        } else {
          audio.pause();
        }
      }
    });

    goLiveBtn.addEventListener('click', () => switchToPresent(true));

    // Rewind 15 seconds (-15s)
    skipBackBtn.addEventListener('click', () => {
      if (mode === 'archive') {
        const currentPos = pendingSeek !== null ? pendingSeek : audio.currentTime;
        if (currentPos >= 15) {
          applySeekToAudio(currentPos - 15);
          if (audio.paused) void audio.play().catch(() => {});
        } else if (activeIndex > 0) {
          // Step seamlessly into the end of the previous recording block
          const prevIndex = activeIndex - 1;
          const prevDur = getKnownDuration(prevIndex);
          const remainder = Math.max(0, 15 - currentPos);
          playArchive(prevIndex, Math.max(0, prevDur - remainder));
        } else {
          applySeekToAudio(0);
          if (audio.paused) void audio.play().catch(() => {});
        }
      } else {
        // In Live mode: if the live element itself has >= 15s buffered, rewind inside live; otherwise jump to 15s before end of latest recording
        if (!live.paused && live.currentTime >= 15) {
          try {
            live.currentTime = Math.max(0, live.currentTime - 15);
            statusBadge.textContent = 'En directo (-15s)';
            const ratio = Math.max(10, Math.min(90, (live.currentTime / Math.max(30, live.currentTime + 15)) * 50));
            progress.value = String(ratio);
            return;
          } catch {}
        }
        if (choices.length > 0) {
          const latestIndex = choices.length - 1;
          const latestDur = getKnownDuration(latestIndex);
          playArchive(latestIndex, Math.max(0, latestDur - 15));
        }
      }
    });

    // Forward 15 seconds (+15s)
    skipForwardBtn.addEventListener('click', () => {
      if (mode === 'archive') {
        const dur = getKnownDuration();
        const currentPos = pendingSeek !== null ? pendingSeek : audio.currentTime;
        if (dur > 0 && currentPos + 15 < dur - 1) {
          applySeekToAudio(currentPos + 15);
          if (audio.paused) void audio.play().catch(() => {});
        } else if (activeIndex >= 0 && activeIndex + 1 < choices.length) {
          playArchive(activeIndex + 1, 0);
        } else {
          switchToPresent(true);
        }
      } else if (!live.paused && live.buffered.length > 0) {
        const bufferedEnd = live.buffered.end(live.buffered.length - 1);
        if (bufferedEnd - live.currentTime > 2) {
          live.currentTime = Math.min(bufferedEnd - 0.5, live.currentTime + 15);
          if (bufferedEnd - live.currentTime <= 2) {
            statusBadge.textContent = 'En directo';
            progress.value = '50';
          }
        }
      }
    });

    // Interactive timeline slider in the middle
    progress.addEventListener('input', () => {
      isScrubbing = true;
      const val = Number(progress.value);
      if (mode === 'archive') {
        const dur = getKnownDuration();
        if (dur > 0) {
          const previewSec = (val / 100) * dur;
          playTime.textContent = `${clock(previewSec)} / ${clock(dur)}`;
        }
      } else {
        // In live mode, dragging left from the middle (50) previews rewinding into the latest cut
        if (val < 50 && choices.length > 0) {
          const latestIndex = choices.length - 1;
          const latestDur = getKnownDuration(latestIndex);
          const targetSec = (val / 50) * latestDur;
          playTime.textContent = `${clock(targetSec)} / ${clock(latestDur)}`;
        } else {
          playTime.textContent = 'En directo';
        }
      }
    });

    progress.addEventListener('change', () => {
      isScrubbing = false;
      const val = Number(progress.value);
      if (mode === 'archive') {
        const dur = getKnownDuration();
        if (dur > 0) {
          applySeekToAudio((val / 100) * dur);
          if (audio.paused) void audio.play().catch(() => {});
        }
      } else {
        if (val < 48 && choices.length > 0) {
          const latestIndex = choices.length - 1;
          const latestDur = getKnownDuration(latestIndex);
          const targetSec = (val / 50) * latestDur;
          playArchive(latestIndex, targetSec);
        } else {
          progress.value = '50';
          playTime.textContent = 'En directo';
        }
      }
    });

    function applyVolume(vol: number) {
      const clamped = Math.max(0, Math.min(1, vol));
      audio.volume = clamped;
      live.volume = clamped;
      volumeInput.value = String(clamped);
      const isMuted = clamped === 0;
      volIconOn.hidden = isMuted;
      volIconMute.hidden = !isMuted;
    }

    volumeInput.addEventListener('input', event => {
      const val = Number((event.target as HTMLInputElement).value);
      if (val > 0) lastVolume = val;
      applyVolume(val);
    });

    muteBtn.addEventListener('click', () => {
      if (audio.volume > 0) {
        lastVolume = audio.volume;
        applyVolume(0);
      } else {
        applyVolume(lastVolume || 1);
      }
    });

    live.addEventListener('play', () => {
      audio.pause();
      if (mode === 'live') {
        setPlayIcon(true);
        statusBadge.textContent = 'En directo';
      }
    });
    live.addEventListener('playing', () => {
      if (mode === 'live') {
        setPlayIcon(true);
        statusBadge.textContent = 'En directo';
      }
    });
    live.addEventListener('waiting', () => {
      if (mode === 'live') statusBadge.textContent = 'Cargando audio…';
    });
    live.addEventListener('pause', () => {
      if (mode === 'live') {
        setPlayIcon(false);
        statusBadge.textContent = 'Pausado';
      }
    });
    live.addEventListener('error', () => {
      if (mode === 'live') {
        setPlayIcon(false);
        statusBadge.textContent = 'En directo';
      }
    });

    audio.addEventListener('play', () => {
      live.pause();
      if (mode === 'archive') {
        setPlayIcon(true);
        statusBadge.textContent = 'Reproduciendo';
      }
    });
    audio.addEventListener('playing', () => {
      if (mode === 'archive') {
        setPlayIcon(true);
        statusBadge.textContent = 'Reproduciendo';
      }
    });
    audio.addEventListener('waiting', () => {
      if (mode === 'archive') statusBadge.textContent = 'Cargando audio…';
    });
    audio.addEventListener('pause', () => {
      if (mode === 'archive') {
        setPlayIcon(false);
        statusBadge.textContent = 'Pausado';
      }
    });
    audio.addEventListener('error', () => {
      if (mode === 'archive') {
        setPlayIcon(false);
        error.hidden = false;
        statusBadge.textContent = 'No se pudo cargar el audio';
      }
    });
    audio.addEventListener('timeupdate', () => {
      if (mode !== 'archive' || isScrubbing) return;
      const cur = pendingSeek !== null ? pendingSeek : audio.currentTime;
      const dur = getKnownDuration();
      playTime.textContent = `${clock(cur)} / ${clock(dur)}`;
      if (dur > 0) {
        progress.value = String(Math.min(100, Math.max(0, (cur / dur) * 100)));
      }
    });
    audio.addEventListener('ended', () => {
      if (activeIndex >= 0 && activeIndex + 1 < choices.length) {
        playArchive(activeIndex + 1, 0);
      } else {
        switchToPresent(true);
      }
    });

    document.querySelector<HTMLButtonElement>('#share-recording')!.addEventListener('click', async () => {
      const shareUrl = new URL(location.href);
      if (mode === 'archive' && activeName) {
        shareUrl.searchParams.set('corte', activeName);
        if (audio.currentTime > 2) shareUrl.searchParams.set('t', String(Math.floor(audio.currentTime)));
      } else {
        shareUrl.searchParams.delete('corte');
        shareUrl.searchParams.delete('t');
      }
      try {
        await navigator.clipboard.writeText(shareUrl.href);
        statusBadge.textContent = 'Enlace copiado';
      } catch {
        statusBadge.textContent = 'Copia la dirección de esta página para compartir';
      }
    });

    document.querySelector<HTMLInputElement>('#recording-search')!.addEventListener('input', event => {
      const query = (event.target as HTMLInputElement).value.trim().toLowerCase();
      for (const choice of choices) {
        choice.closest('li')!.hidden = !choice.textContent?.toLowerCase().includes(query);
      }
      document.querySelectorAll<HTMLTableRowElement>('[data-song-row]').forEach(row => {
        row.hidden = !row.textContent?.toLowerCase().includes(query);
      });
    });

    document.addEventListener('click', event => {
      const target = event.target as Element;

      const button = target.closest<HTMLButtonElement>('[data-radio-audio]');
      if (button) {
        playArchive(choices.indexOf(button), 0);
        return;
      }

      const chip = target.closest<HTMLButtonElement>('[data-chip]');
      if (chip) {
        const index = choices.findIndex(choice => choice.dataset.radioAudio === chip.dataset.chip);
        if (index >= 0) playArchive(index, 0);
        return;
      }

      const seekBtn = target.closest<HTMLButtonElement>('[data-seek-audio]');
      if (seekBtn) {
        const audioTarget = seekBtn.dataset.seekAudio || '';
        const offset = Number(seekBtn.dataset.seekOffset) || 0;
        const songTitle = seekBtn.dataset.seekTitle || '';
        const songArt = seekBtn.dataset.seekArt || '';
        const index = choices.findIndex(choice => choice.dataset.radioAudio === audioTarget);
        if (index >= 0) {
          playArchive(index, offset, songTitle, songArt);
        }
        return;
      }

      const triggerLive = target.closest<HTMLButtonElement>('[data-trigger-live]');
      if (triggerLive) {
        switchToPresent(true);
        return;
      }

      const day = target.closest<HTMLAnchorElement>('.radio-days a');
      if (day) {
        event.preventDefault();
        void changeDate(new URL(day.href).searchParams.get('fecha') || '');
      }
    });

    const dateInput = document.querySelector<HTMLInputElement>('#radio-date');
    async function changeDate(date: string, push = true) {
      if (!dateInput || date < dateInput.min || date > dateInput.max) return;
      const url = new URL(location.href);
      url.searchParams.set('fecha', date);
      url.searchParams.delete('corte');
      url.searchParams.delete('t');
      try {
        const response = await fetch(url, { headers: { Accept: 'text/html' } });
        if (!response.ok) throw new Error('date');
        const page = new DOMParser().parseFromString(await response.text(), 'text/html');
        const currentExplorer = document.querySelector('.explorer .card-body');
        const replacementExplorer = page.querySelector('.explorer .card-body');
        if (!currentExplorer || !replacementExplorer) return;
        currentExplorer.innerHTML = replacementExplorer.innerHTML;

        const chips = page.querySelector('.recording-chips');
        if (chips && document.querySelector('.recording-chips')) {
          document.querySelector('.recording-chips')!.innerHTML = chips.innerHTML;
        }
        const songsSection = page.querySelector('#canciones');
        if (songsSection && document.querySelector('#canciones')) {
          document.querySelector('#canciones')!.innerHTML = songsSection.innerHTML;
        }

        choices = [...document.querySelectorAll<HTMLButtonElement>('[data-radio-audio]')];
        updatePressedStates(mode === 'archive' && choices[activeIndex] ? choices[activeIndex].dataset.radioAudio || null : null);
        if (push) history.pushState({}, '', url);
      } catch {
        location.href = url.href;
      }
    }

    document.addEventListener('change', event => {
      const input = event.target as HTMLInputElement;
      if (input.id === 'radio-date') void changeDate(input.value);
    });

    document.addEventListener('click', event => {
      const id = (event.target as Element).closest('button')?.id;
      if (id !== 'previous-day' && id !== 'next-day') return;
      const input = document.querySelector<HTMLInputElement>('#radio-date');
      if (!input) return;
      const day = new Date(input.value + 'T12:00:00Z');
      day.setUTCDate(day.getUTCDate() + (id === 'previous-day' ? -1 : 1));
      void changeDate(day.toISOString().slice(0, 10));
    });

    window.addEventListener('popstate', () => {
      void changeDate(new URL(location.href).searchParams.get('fecha') || dateInput?.max || '', false);
    });

    async function refreshStationStatus() {
      try {
        const currentFecha = document.querySelector<HTMLInputElement>('#radio-date')?.value || '';
        const res = await fetch(`${radioPath}status.json?fecha=${encodeURIComponent(currentFecha)}`, {
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) return;
        const data = await res.json();
        if (data.station) {
          if (data.station.listenUrl) {
            liveStreamUrl = data.station.listenUrl;
            if (!live.getAttribute('src')) live.src = liveStreamUrl;
          }
          if (data.station.nowPlaying) {
            const np = data.station.nowPlaying;
            liveTrackTitle = `${np.artist ? np.artist + ' — ' : ''}${np.title}`;
            liveTrackArt = np.art || '';
            if (mode === 'live') {
              selection.textContent = liveTrackTitle;
              setArtwork(liveTrackArt);
            }
          }
        }
      } catch {}
    }

    const initialParams = new URL(location.href).searchParams;
    const requestedCut = initialParams.get('corte');
    const requestedOffset = Number(initialParams.get('t')) || 0;
    if (requestedCut) {
      const idx = choices.findIndex(c => c.dataset.radioName === requestedCut);
      if (idx >= 0) {
        playArchive(idx, requestedOffset);
      } else {
        switchToPresent(false);
      }
    } else {
      switchToPresent(false);
    }

    setInterval(refreshStationStatus, 20_000);
  </script>
</body>
