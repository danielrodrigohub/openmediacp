---
import '@fontsource-variable/source-sans-3';
import '../../../styles/theme.css';
import Brand from '../../../components/Brand.astro';
import Icon from '../../../components/Icon.astro';
import { publicRadio, radioDate, radioDays, radioHour, recordingsFor } from '../../../server/radio';

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
const channel = publicRadio(Astro.params.id);
if (!channel) return new Response('Radio a la carta no disponible.', {
  status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow, noarchive' },
});
const recordings = recordingsFor(channel.id);
const days = radioDays();
const requested = Astro.url.searchParams.get('fecha');
const date = requested && days.includes(requested) ? requested :
  days.find(day => recordings.some(item => radioDate(item.start) === day)) ?? days[0];
const selections = recordings.filter(item => radioDate(item.start) === date);
const dateFormat = new Intl.DateTimeFormat('es-CL', {
  timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long',
});
const calendarDay = (day: string) => new Date(day + 'T12:00:00Z');
const dateLabel = (day: string) => dateFormat.format(calendarDay(day));
const shortDate = new Intl.DateTimeFormat('es-CL', { timeZone: 'UTC', weekday: 'short', day: 'numeric' });
const timeRange = (start: number, end: number) => `${radioHour(start)} – ${radioHour(end)}`;
const radioPath = `/radio/${channel.id}/`;
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow, noarchive"/>
  <title>{channel.name} · Radio a la carta</title>
</head>
<body class="shared-player-page">
  <header class="public-header"><Brand/></header>
  <main class="radio-page">
    <div class="page-heading">
      <div><h1>{channel.name}</h1><p>Radio a la carta</p></div>
    </div>
    <section class="card live-card">
      <div class="card-heading"><h2>En directo</h2><span class="hint">Buffer automático</span></div>
      <div class="card-body live-body">
        <p class="live-note">Escucha la señal con unos segundos de margen. Si retrocedes, cambia a la grabación Opus disponible.</p>
        <audio id="radio-live" controls preload="auto" src={channel.source_url}></audio>
        <button id="radio-live-return" class="button" type="button" hidden>Volver al directo</button>
      </div>
    </section>
    <section class="card">
      <div class="card-heading"><h2>Grabaciones</h2><span class="hint">Cortes cada 5 minutos · hora de Chile continental</span></div>
      <div class="card-body">
        <nav class="radio-days" aria-label="Fecha de la grabación">
          {days.map((day, index) => <a href={`${radioPath}?fecha=${day}`} aria-label={index === 0 ? 'Hoy, ' + dateLabel(day) : dateLabel(day)} aria-current={day === date ? 'page' : undefined} class:list={['button', 'day-button', day === date ? 'primary' : '']}><strong>{index === 0 ? 'Hoy' : shortDate.format(calendarDay(day))}</strong><small>{calendarDay(day).getUTCDate()}</small></a>)}
        </nav>
        <div class="recording-day-heading"><h3>{dateLabel(date)}</h3><span>{selections.length} {selections.length === 1 ? 'corte disponible' : 'cortes disponibles'}</span></div>
        {selections.length ? <>
          <audio id="radio-audio" aria-label="Reproductor de grabaciones" controls preload="metadata" src={radioPath + selections[0].name}></audio>
          <p id="radio-selection" class="hint" aria-live="polite">{timeRange(selections[0].start, selections[0].end)}</p>
          <ul class="radio-hours">
            {selections.map((item, index) => <li><span class="hour-label">{radioHour(item.start)}</span><button type="button" class="button" data-radio-audio={radioPath + item.name} data-radio-time={timeRange(item.start, item.end)} aria-pressed={index === 0 ? 'true' : 'false'}><Icon name="play" size={18}/><span>{timeRange(item.start, item.end)}</span></button></li>)}
          </ul>
          <p id="radio-error" class="hint" role="status" hidden>No se pudo cargar el audio. Selecciona el horario para volver a intentarlo.</p>
        </> : <p class="hint">Todavía no hay grabaciones disponibles para esta fecha.</p>}
      </div>
    </section>
  </main>
  <script>
    const live = document.querySelector<HTMLAudioElement>('#radio-live');
    const liveReturn = document.querySelector<HTMLButtonElement>('#radio-live-return');
    const audio = document.querySelector<HTMLAudioElement>('#radio-audio');
    const selection = document.querySelector<HTMLElement>('#radio-selection');
    const error = document.querySelector<HTMLElement>('#radio-error');
    const choices = [...document.querySelectorAll<HTMLButtonElement>('[data-radio-audio]')];
    let active = 0;

    function play(index: number) {
      if (!audio || !selection || !error) return;
      const button = choices[index];
      choices[active].setAttribute('aria-pressed', 'false');
      button.setAttribute('aria-pressed', 'true');
      active = index;
      error.hidden = true;
      selection.textContent = button.dataset.radioTime || '';
      audio.src = button.dataset.radioAudio || '';
      live?.pause();
      if (liveReturn) liveReturn.hidden = false;
      void audio.play().catch(() => {
        if (active === index && audio.error) error.hidden = false;
      });
    }

    choices.forEach((button, index) => button.addEventListener('click', () => play(index)));
    liveReturn?.addEventListener('click', () => {
      audio?.pause();
      if (live) { live.load(); void live.play().catch(() => {}); }
      liveReturn.hidden = true;
    });
    audio?.addEventListener('error', () => { if (error) error.hidden = false; });
    audio?.addEventListener('ended', () => { if (active + 1 < choices.length) play(active + 1); });
  </script>
</body>
</html>
<style>
.radio-page { width: min(100%, 1180px); margin: 0 auto; padding: 28px 20px 48px; }
.radio-page>.page-heading { margin-bottom: 20px; }
.radio-page>.page-heading h1 { margin-bottom: 4px; }
.live-card { margin-block-end: 18px; }
.radio-page .card { border-radius: 8px; overflow: hidden; }
.radio-page .card-heading { min-height: 56px; }
.live-body { display: grid; gap: 12px; }
.live-note { margin: 0; color: var(--muted, #52637d); }
.radio-days { display: flex; flex-wrap: wrap; gap: 8px; padding-bottom: 16px; border-bottom: 1px solid var(--border); }
.day-button { min-width: 72px; min-height: 56px; flex-direction: column; gap: 1px; }
.day-button small { font-size: 12px; opacity: .8; }
.recording-day-heading { display:flex; justify-content:space-between; align-items:baseline; gap:12px; flex-wrap:wrap; }
.recording-day-heading h3 { margin: 16px 0 12px; text-transform:capitalize; }
.recording-day-heading span,.hour-label { color:var(--muted); font-size:13px; }
.radio-hours { list-style: none; padding: 0; margin: 12px 0 0; display:grid; grid-template-columns:repeat(auto-fill,minmax(190px,1fr)); gap:8px; }
.radio-hours li { display:flex; align-items:center; gap:8px; min-width:0; }
.radio-hours button { width:100%; justify-content:flex-start; min-height:44px; }
.radio-hours button[aria-pressed="true"] { border-color: var(--accent); color:var(--accent); background:var(--accent-soft); }
audio { display: block; width: min(100%, 720px); }
@media(max-width:600px){.radio-page{padding:20px 12px 32px}.day-button{min-width:58px;flex:1}.radio-page .card-heading{align-items:flex-start;flex-direction:column}.radio-hours{grid-template-columns:1fr}}
</style>
