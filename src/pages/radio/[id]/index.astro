---
import '@fontsource-variable/source-sans-3';
import '../../../styles/theme.css';
import Brand from '../../../components/Brand.astro';
import Icon from '../../../components/Icon.astro';
import {
  groupRecordingsForDisplay,
  programsForChannel,
  publicRadio,
  radioDate,
  radioDays,
  radioHour,
  recordingsFor,
  resolveLiveDisplayTitle,
  songsForDate,
  syncStationApi,
} from '../../../server/radio';

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
const channel = publicRadio(Astro.params.id);
if (!channel) return new Response('Radio a la carta no disponible.', {
  status: 404, headers: { 'X-Robots-Tag': 'noindex, nofollow, noarchive' },
});

const station = await syncStationApi(channel.id, channel.station_api_url);
const programs = programsForChannel(channel.id);
const liveDisplay = resolveLiveDisplayTitle(station, programs);
const stationName = station.name || channel.name;
const liveStreamUrl = station.listen_url || channel.source_url || '';

const recordings = recordingsFor(channel.id);
const days = radioDays();
const requested = Astro.url.searchParams.get('fecha');
const date = requested && days.includes(requested) ? requested : days[0];
const dayRecordings = recordings.filter(item => radioDate(item.start) === date);
const selections = groupRecordingsForDisplay(dayRecordings, programs);
const songs = songsForDate(channel.id, date, dayRecordings, station.now_playing?.played_at);

const capitalizeFirst = (value: string) => value ? value.charAt(0).toUpperCase() + value.slice(1) : '';
const dateFormat = new Intl.DateTimeFormat('es-CL', {
  timeZone: 'UTC', weekday: 'long', day: 'numeric', month: 'long',
});
const calendarDay = (day: string) => new Date(day + 'T12:00:00Z');
const dateLabel = (day: string) => capitalizeFirst(dateFormat.format(calendarDay(day)));
const shortDate = new Intl.DateTimeFormat('es-CL', { timeZone: 'UTC', weekday: 'short', day: 'numeric' });
const shortLabel = (day: string) => shortDate.format(calendarDay(day)).replace(/\./g, '');
const timeRange = (start: number, end: number) => {
  const s = radioHour(start);
  const e = radioHour(end);
  return s === e ? `${s} – ${radioHour(start + 60_000)}` : `${s} – ${e}`;
};
const formatTotalDuration = (seconds: number) => {
  const totalSec = Math.max(1, Math.round(seconds));
  if (totalSec < 60) return `${totalSec} s`;
  const totalMins = Math.round(totalSec / 60);
  if (totalMins < 60) return `${totalMins} min`;
  const hrs = Math.floor(totalMins / 60);
  const mins = totalMins % 60;
  return mins > 0 ? `${hrs} h ${mins} min` : `${hrs} h`;
};
const formatSongDuration = (seconds: number) => {
  if (!seconds || seconds <= 0) return '—';
  const mins = Math.floor(seconds / 60);
  const secs = Math.floor(seconds % 60).toString().padStart(2, '0');
  return `${mins}:${secs}`;
};
const radioPath = `/radio/${channel.id}/`;
const groupAudioUrl = (item: typeof selections[number]) =>
  item.segments.length > 1
    ? `${radioPath}emision.ogg?fecha=${encodeURIComponent(date)}&grupo=${encodeURIComponent(item.id)}`
    : radioPath + item.segments[0].name;
const groupCastUrl = (item: typeof selections[number]) =>
  `${radioPath}emision.webm?fecha=${encodeURIComponent(date)}&grupo=${encodeURIComponent(item.id)}`;
const nowPlayingText = liveDisplay.title;
const nowPlayingArt = station.now_playing?.art || '';
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8"/>
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <meta name="robots" content="noindex, nofollow, noarchive"/>
  <title>{stationName} · Radio a la carta</title>
</head>
<body class="shared-player-page" data-radio-path={radioPath} data-station-name={stationName} data-live-url={liveStreamUrl}>
  <header class="radio-header">
    <div class="radio-header-inner">
      <div class="radio-header-brand">
        <Brand/>
        <div class="radio-identity">
          <strong id="header-station-name">{stationName}</strong>
          <small>Radio a la carta</small>
        </div>
      </div>

      <label class="radio-search">
        <Icon name="search" size={16}/>
        <input type="search" id="recording-search" placeholder="Buscar programa, horario o canción" aria-label="Buscar programa, horario o canción"/>
      </label>
    </div>
  </header>

  <main class="radio-page">
    <h1 class="sr-only">{stationName} · Radio a la carta</h1>

    <div class="radio-layout">
      <aside class="card explorer" id="programas" aria-label="Emisiones por fecha">
        <div class="card-heading">
          <h2>Emisiones</h2>
          <span class="cuts-count" id="cuts-count-label">
            {selections.length} {selections.length === 1 ? 'emisión' : 'emisiones'}
          </span>
        </div>

        <div class="card-body">
          <input type="hidden" id="radio-date" value={date} data-min={days[days.length - 1]} data-max={days[0]}/>

          <nav class="radio-days" aria-label="Días disponibles">
            {days.map((day, index) => (
              <a
                href={`${radioPath}?fecha=${day}`}
                aria-label={index === 0 ? 'Hoy, ' + dateLabel(day) : dateLabel(day)}
                aria-current={day === date ? 'page' : undefined}
                class:list={['button', 'day-button', day === date ? 'primary' : '']}
              >
                {index === 0 ? 'Hoy' : shortLabel(day)}
              </a>
            ))}
          </nav>

          <div class="recording-day-heading">
            <h3>{dateLabel(date)}</h3>
          </div>

          {selections.length ? (
            <>
              <ul class="radio-hours" id="sidebar-recordings-list">
                {selections.map(item => (
                  <li>
                    <button
                      type="button"
                      class="recording-row"
                      data-radio-audio={groupAudioUrl(item)}
                      data-radio-cast-audio={groupCastUrl(item)}
                      data-radio-name={item.id}
                      data-radio-start={item.start}
                      data-radio-end={item.end}
                      data-radio-duration={Math.round(item.totalSeconds)}
                      data-radio-time={timeRange(item.start, item.end)}
                      data-radio-date={dateLabel(date)}
                      data-radio-program={item.programName}
                      data-segments={JSON.stringify(item.segments.map(seg => ({
                        name: seg.name,
                        url: radioPath + seg.name,
                        start: seg.start,
                        end: seg.end,
                        dur: Math.max(1, (seg.end - seg.start) / 1000),
                      })))}
                      aria-pressed="false"
                    >
                      <span class="segment-meta">
                        {item.programName ? (
                          <>
                            <strong class="segment-program">{item.programName}</strong>
                            <small class="segment-time">{timeRange(item.start, item.end)} hrs · {formatTotalDuration(item.totalSeconds)}</small>
                          </>
                        ) : (
                          <>
                            <strong class="segment-time-primary">{timeRange(item.start, item.end)} hrs</strong>
                            <small class="segment-duration">{formatTotalDuration(item.totalSeconds)}</small>
                          </>
                        )}
                      </span>
                      <span class="row-play" aria-hidden="true">
                        <Icon name="play" size={14}/>
                      </span>
                    </button>
                  </li>
                ))}
              </ul>
              <p class="empty-filter" id="recordings-empty-search" hidden>Sin emisiones que coincidan con la búsqueda.</p>
            </>
          ) : (
            <p class="empty-state-inline">Todavía no hay grabaciones disponibles para esta fecha.</p>
          )}
        </div>
      </aside>

      <div class="radio-content">
        <section class="player-panel" id="inicio" aria-labelledby="player-title">
          <div class="player-art" id="player-art-box">
            <img
              id="player-art-img"
              src={nowPlayingArt || undefined}
              alt={`Carátula de ${stationName}`}
              hidden={!nowPlayingArt}
              loading="eager"
            />
            <span id="player-art-fallback" class="player-art-icon" hidden={Boolean(nowPlayingArt)} aria-hidden="true">
              <Icon name="broadcast" size={40}/>
            </span>
          </div>

          <div class="player-main">
            <div class="player-top">
              <span class="mode-badge" id="play-state" data-mode="live">
                <span class="live-dot" aria-hidden="true"></span>
                <span id="play-state-text">En directo</span>
              </span>
              <button id="go-live" type="button" class="go-live-btn" hidden>
                <Icon name="broadcast" size={15}/>
                <span>Volver al directo</span>
              </button>
            </div>

            <h2 id="player-title">{stationName}</h2>
            <div class="player-subtitle-viewport" id="subtitle-viewport">
              <p id="radio-selection" class="player-subtitle" aria-live="polite" data-live-text={nowPlayingText}>
                {nowPlayingText}
              </p>
            </div>

            <audio id="radio-audio" aria-label="Reproductor de grabaciones" preload="metadata"></audio>
            <audio id="radio-live" aria-label="Escuchar en directo" preload="auto" src={liveStreamUrl}></audio>

            <div class="custom-controls">
              <div class="transport-group">
                <button id="skip-back" type="button" class="skip-btn" aria-label="Retroceder 15 segundos" title="Retroceder 15 s">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M3.5 12a8.5 8.5 0 1 0 2.5-6L3.5 8.5"/>
                    <path d="M3.5 4v4.5H8"/>
                    <text x="12" y="15.2" text-anchor="middle" font-size="7.2" font-weight="700" fill="currentColor" stroke="none">15</text>
                  </svg>
                </button>

                <button id="toggle-play" type="button" class="play-btn" aria-label="Reproducir">
                  <span class="icon-play">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <polygon points="8,5 20,12 8,19"/>
                    </svg>
                  </span>
                  <span class="icon-pause" hidden>
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <rect x="6.5" y="5" width="4" height="14" rx="1"/>
                      <rect x="13.5" y="5" width="4" height="14" rx="1"/>
                    </svg>
                  </span>
                </button>

                <button id="skip-forward" type="button" class="skip-btn" aria-label="Avanzar 15 segundos" title="Avanzar 15 s">
                  <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M20.5 12a8.5 8.5 0 1 1-2.5-6l2.5 2.5"/>
                    <path d="M20.5 4v4.5H16"/>
                    <text x="12" y="15.2" text-anchor="middle" font-size="7.2" font-weight="700" fill="currentColor" stroke="none">15</text>
                  </svg>
                </button>
              </div>

              <div class="scrubber-group">
                <output id="play-time">En directo</output>
                <input
                  id="play-progress"
                  type="range"
                  min="0"
                  max="100"
                  step="0.1"
                  value="100"
                  style="--progress: 100%"
                  aria-label="Posición de reproducción"
                />
              </div>

              <div class="utility-group">
                <div class="volume-control">
                  <button id="mute-toggle" type="button" class="icon-only-btn" aria-label="Silenciar o activar sonido" title="Volumen">
                    <span id="vol-icon-on"><Icon name="volume" size={18}/></span>
                    <span id="vol-icon-mute" hidden><Icon name="mute" size={18}/></span>
                  </button>
                  <input id="play-volume" type="range" min="0" max="1" step="0.05" value="1" style="--vol: 100%" aria-label="Volumen"/>
                </div>

                <button id="radio-airplay" type="button" class="icon-only-btn" hidden aria-label="Escuchar con AirPlay" title="AirPlay">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 17H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2h-1"/>
                    <polygon points="12 15 17 21 7 21 12 15"/>
                  </svg>
                </button>

                <button id="radio-cast" type="button" class="icon-only-btn" hidden aria-label="Enviar a Google Cast" title="Google Cast">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M2 16.1A5 5 0 0 1 5.9 20M2 12.05A9 9 0 0 1 9.95 20M2 8V6a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-6"/>
                    <line x1="2" y1="20" x2="2.01" y2="20"/>
                  </svg>
                </button>

                <button id="share-recording" type="button" class="icon-only-btn" aria-label="Copiar enlace" title="Copiar enlace">
                  <span id="share-icon-link">
                    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="18" cy="5" r="3"/>
                      <circle cx="6" cy="12" r="3"/>
                      <circle cx="18" cy="19" r="3"/>
                      <line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/>
                      <line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/>
                    </svg>
                  </span>
                  <span id="share-icon-check" hidden><Icon name="check" size={17}/></span>
                </button>
              </div>
            </div>

            <p id="radio-error" class="player-error" role="status" hidden>
              No se pudo cargar el audio. Selecciona otro tramo o vuelve al directo.
            </p>
          </div>
        </section>

        <section class="card songs-panel" id="canciones" hidden={!songs.length}>
          <div class="card-heading">
            <h2>Canciones emitidas</h2>
            <span class="cuts-count" id="songs-count-label">
              {songs.length} {songs.length === 1 ? 'registro' : 'registros'}
            </span>
          </div>
          <div class="card-body songs-table-wrap">
            <table id="songs-table">
              <colgroup>
                <col class="col-time"/>
                <col class="col-title"/>
                <col class="col-artist"/>
                <col class="col-duration"/>
                <col class="col-action"/>
              </colgroup>
              <thead>
                <tr>
                  <th>Hora</th>
                  <th>Canción</th>
                  <th>Artista</th>
                  <th>Duración</th>
                  <th>Grabación</th>
                </tr>
              </thead>
              <tbody id="songs-tbody">
                {songs.length ? songs.map(song => (
                  <tr
                    data-song-row
                    data-has-recording={song.recording ? 'true' : 'false'}
                    data-recording-name={song.recording?.name || ''}
                    data-played-at={song.played_at}
                  >
                    <td class="song-time-cell">
                      <span>{radioHour(song.played_at * 1000)}</span>
                      {song.is_current && <span class="song-live-pill">Ahora</span>}
                    </td>
                    <td class="song-title-td">
                      <div class="song-title-cell">
                        {song.art && <img src={song.art} alt="" class="song-thumb" loading="lazy"/>}
                        <strong title={song.title}>{song.title}</strong>
                      </div>
                    </td>
                    <td class="song-artist-td" title={song.artist || stationName}>{song.artist || stationName}</td>
                    <td class="song-duration-cell">{formatSongDuration(song.duration)}</td>
                    <td class="song-action-td">
                      {song.recording ? (
                        <button
                          type="button"
                          class="button small song-seek-btn"
                          data-seek-audio={radioPath + song.recording.name}
                          data-seek-offset={song.recording.offset}
                          data-seek-title={`${song.artist ? song.artist + ' — ' : ''}${song.title}`}
                          data-seek-art={song.art}
                        >
                          <Icon name="play" size={12}/>
                          <span>{timeRange(song.recording.start, song.recording.end)}</span>
                        </button>
                      ) : song.is_current ? (
                        <button type="button" class="button small song-seek-btn" data-trigger-live="true">
                          <Icon name="broadcast" size={12}/>
                          <span>En directo</span>
                        </button>
                      ) : (
                        <span class="no-archive-tag">Sin corte</span>
                      )}
                    </td>
                  </tr>
                )) : (
                  <tr>
                    <td colspan="5" class="songs-empty-cell">
                      No hay registro de canciones para esta fecha.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
            <p class="empty-filter" id="songs-empty-search" hidden>Sin canciones que coincidan con la búsqueda.</p>
          </div>
        </section>

        <section class="card songs-panel" id="horario-grabaciones" hidden={Boolean(songs.length)}>
          <div class="card-heading">
            <h2>Detalle de grabaciones</h2>
            <span class="cuts-count">{dateLabel(date)}</span>
          </div>
          <div class="card-body songs-table-wrap">
            <table>
              <colgroup>
                <col class="col-time"/>
                <col class="col-title"/>
                <col class="col-duration"/>
                <col class="col-action"/>
              </colgroup>
              <thead>
                <tr>
                  <th>Inicio</th>
                  <th>Tramo</th>
                  <th>Duración</th>
                  <th>Escuchar</th>
                </tr>
              </thead>
              <tbody>
                {selections.length ? selections.map(item => (
                  <tr>
                    <td class="song-time-cell"><strong>{radioHour(item.start)}</strong></td>
                    <td class="song-title-td">
                      <strong>{item.programName ? `${item.programName} · ${timeRange(item.start, item.end)} hrs` : `Tramo ${timeRange(item.start, item.end)} hrs`}</strong>
                    </td>
                    <td class="song-duration-cell">{formatTotalDuration(item.totalSeconds)}</td>
                    <td class="song-action-td">
                      <button
                        type="button"
                        class="button small song-seek-btn"
                        data-chip={groupAudioUrl(item)}
                      >
                        <Icon name="play" size={12}/>
                        <span>{timeRange(item.start, item.end)}</span>
                      </button>
                    </td>
                  </tr>
                )) : (
                  <tr>
                    <td colspan="4" class="songs-empty-cell">
                      Todavía no hay tramos grabados disponibles para esta fecha.
                    </td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        </section>
      </div>
    </div>
  </main>

  <footer class="radio-footer">
    <div class="radio-footer-inner">
      <Brand/>
      <span class="footer-station">{stationName}</span>
      <span class="footer-tz">Hora de Chile continental</span>
    </div>
  </footer>

  <nav class="mobile-radio-nav" aria-label="Navegación móvil">
    <a href="#inicio"><Icon name="broadcast" size={18}/><span>Directo</span></a>
    <a href="#programas"><Icon name="clock" size={18}/><span>Emisiones</span></a>
    <a href={songs.length ? '#canciones' : '#horario-grabaciones'} id="mobile-songs-link">
      <Icon name="music" size={18}/><span>Canciones</span>
    </a>
  </nav>

  <script>
    const bodyEl = document.body;
    const radioPath = bodyEl.dataset.radioPath || location.pathname;
    const stationFallbackName = bodyEl.dataset.stationName || '';
    let liveStreamUrl = bodyEl.dataset.liveUrl || '';
    const live = document.querySelector<HTMLAudioElement>('#radio-live')!;
    const audio = document.querySelector<HTMLAudioElement>('#radio-audio')!;
    const selection = document.querySelector<HTMLElement>('#radio-selection')!;
    const subtitleViewport = document.querySelector<HTMLElement>('#subtitle-viewport')!;
    const error = document.querySelector<HTMLElement>('#radio-error')!;
    const toggle = document.querySelector<HTMLButtonElement>('#toggle-play')!;
    const iconPlay = toggle.querySelector<HTMLElement>('.icon-play')!;
    const iconPause = toggle.querySelector<HTMLElement>('.icon-pause')!;
    const progress = document.querySelector<HTMLInputElement>('#play-progress')!;
    const playTime = document.querySelector<HTMLElement>('#play-time')!;
    const statusBadge = document.querySelector<HTMLElement>('#play-state')!;
    const statusText = document.querySelector<HTMLElement>('#play-state-text')!;
    const goLiveBtn = document.querySelector<HTMLButtonElement>('#go-live')!;
    const artImg = document.querySelector<HTMLImageElement>('#player-art-img')!;
    const artFallback = document.querySelector<HTMLElement>('#player-art-fallback')!;
    const skipBackBtn = document.querySelector<HTMLButtonElement>('#skip-back')!;
    const skipForwardBtn = document.querySelector<HTMLButtonElement>('#skip-forward')!;
    const volumeInput = document.querySelector<HTMLInputElement>('#play-volume')!;
    const muteBtn = document.querySelector<HTMLButtonElement>('#mute-toggle')!;
    const volIconOn = document.querySelector<HTMLElement>('#vol-icon-on')!;
    const volIconMute = document.querySelector<HTMLElement>('#vol-icon-mute')!;
    const shareBtn = document.querySelector<HTMLButtonElement>('#share-recording')!;
    const shareIconLink = document.querySelector<HTMLElement>('#share-icon-link')!;
    const shareIconCheck = document.querySelector<HTMLElement>('#share-icon-check')!;
    const searchInput = document.querySelector<HTMLInputElement>('#recording-search')!;

    let choices = [...document.querySelectorAll<HTMLButtonElement>('[data-radio-audio]')];
    let mode: 'live' | 'archive' = 'live';
    const { initRadioWireless } = await import('../../../lib/radio-wireless');
    const wireless = initRadioWireless({
      audio,
      live,
      active: () => mode === 'live' ? live : audio,
      title: stationFallbackName,
      getDetails: () => {
        const isLive = mode === 'live';
        const btn = activeIndex >= 0 ? choices[activeIndex] : null;
        const art = (!artImg.hidden && artImg.getAttribute('src')) ? artImg.getAttribute('src')! : liveTrackArt;
        return {
          title: (selection.textContent || '').trim() || stationFallbackName,
          artist: stationFallbackName,
          subtitle: isLive ? 'En directo' : `${btn?.dataset.radioDate || 'Grabación'} · ${btn?.dataset.radioTime || ''} hrs`.trim(),
          artwork: art || undefined,
          castUrl: isLive ? liveStreamUrl : (btn?.dataset.radioCastAudio || btn?.dataset.radioAudio || ''),
          isLive,
          startTime: isLive ? 0 : (pendingSeek !== null ? pendingSeek : (Number.isFinite(audio.currentTime) ? audio.currentTime : 0)),
        };
      },
      onEnd: () => switchToPresent(true),
    });

    type SegmentInfo = { name: string; url: string; start: number; end: number; dur: number };

    let activeIndex = -1;
    let activeName = '';
    let pendingSeek: number | null = null;
    let isScrubbing = false;
    let lastVolume = 1;
    let liveTrackTitle = selection.dataset.liveText || 'Señal en directo';
    let liveTrackArt = artImg.getAttribute('src') || '';
    let shareResetTimer: number | null = null;

    const clock = (seconds: number) => {
      if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
      const total = Math.floor(seconds);
      const hrs = Math.floor(total / 3600);
      const mins = Math.floor((total % 3600) / 60);
      const secs = total % 60;
      if (hrs > 0) return `${hrs}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
      return `${mins}:${secs.toString().padStart(2, '0')}`;
    };

    const formatDurationLabel = (seconds: number) => {
      const totalSec = Math.max(1, Math.round(seconds));
      if (totalSec < 60) return `${totalSec} s`;
      const totalMins = Math.round(totalSec / 60);
      if (totalMins < 60) return `${totalMins} min`;
      const hrs = Math.floor(totalMins / 60);
      const mins = totalMins % 60;
      return mins > 0 ? `${hrs} h ${mins} min` : `${hrs} h`;
    };

    function setProgressValue(pct: number) {
      const clamped = Math.max(0, Math.min(100, pct));
      progress.value = String(clamped);
      progress.style.setProperty('--progress', `${clamped}%`);
    }

    function setBadgeState(text: string, badgeMode: 'live' | 'archive' | 'paused' | 'error' = mode) {
      statusText.textContent = text;
      statusBadge.dataset.mode = badgeMode;
    }

    function getGroupSegments(index: number): SegmentInfo[] {
      const btn = choices[index];
      if (!btn) return [];
      try {
        const parsed = JSON.parse(btn.dataset.segments || '[]');
        if (Array.isArray(parsed) && parsed.length > 0) return parsed;
      } catch {}
      const start = Number(btn.dataset.radioStart) || 0;
      const end = Number(btn.dataset.radioEnd) || 0;
      return [{
        name: btn.dataset.radioName || '',
        url: btn.dataset.radioAudio || '',
        start,
        end,
        dur: Math.max(1, (end - start) / 1000),
      }];
    }

    function getKnownDuration(index = activeIndex): number {
      if (index === activeIndex && Number.isFinite(audio.duration) && audio.duration > 1) {
        return audio.duration;
      }
      const btn = choices[index];
      if (btn) {
        const declared = Number(btn.dataset.radioDuration) || 0;
        if (declared > 0) return declared;
        const start = Number(btn.dataset.radioStart) || 0;
        const end = Number(btn.dataset.radioEnd) || 0;
        if (end > start) return (end - start) / 1000;
      }
      return 0;
    }

    function getGlobalCurrentTime(): number {
      if (mode !== 'archive') return 0;
      return pendingSeek !== null ? pendingSeek : (Number.isFinite(audio.currentTime) ? audio.currentTime : 0);
    }

    function findGroupForRecording(urlOrName: string): { groupIndex: number; segOffsetStart: number } | null {
      for (let i = 0; i < choices.length; i++) {
        if (choices[i].dataset.radioName === urlOrName || choices[i].dataset.radioAudio === urlOrName) {
          return { groupIndex: i, segOffsetStart: 0 };
        }
        const segs = getGroupSegments(i);
        let offset = 0;
        for (let j = 0; j < segs.length; j++) {
          if (segs[j].url === urlOrName || segs[j].name === urlOrName) {
            return { groupIndex: i, segOffsetStart: offset };
          }
          offset += Math.max(1, segs[j].dur || 1);
        }
      }
      return null;
    }

    function setSubtitleText(text: string) {
      if (selection.textContent === text && selection.dataset.measuredWidth === String(subtitleViewport.clientWidth)) {
        return;
      }
      selection.textContent = text;
      updateSubtitleTicker();
    }

    function updateSubtitleTicker() {
      selection.classList.remove('is-scrolling');
      selection.style.removeProperty('--scroll-offset');
      selection.style.removeProperty('--scroll-duration');
      selection.dataset.measuredWidth = String(subtitleViewport.clientWidth);
      requestAnimationFrame(() => {
        const viewportWidth = subtitleViewport.clientWidth;
        const textWidth = selection.scrollWidth;
        const overflow = Math.ceil(textWidth - viewportWidth);
        if (viewportWidth > 0 && overflow > 4) {
          const duration = Math.max(8, Math.min(18, 6.5 + overflow / 26));
          selection.style.setProperty('--scroll-offset', `-${overflow}px`);
          selection.style.setProperty('--scroll-duration', `${duration.toFixed(1)}s`);
          void selection.offsetWidth;
          selection.classList.add('is-scrolling');
        }
      });
    }

    window.addEventListener('resize', () => updateSubtitleTicker());

    function setArtwork(url?: string) {
      if (url) {
        artImg.src = url;
        artImg.hidden = false;
        artFallback.hidden = true;
      } else {
        artImg.removeAttribute('src');
        artImg.hidden = true;
        artFallback.hidden = false;
      }
    }

    artImg.addEventListener('error', () => {
      artImg.hidden = true;
      artFallback.hidden = false;
    });

    function setPlayIcon(playing: boolean) {
      iconPlay.hidden = playing;
      iconPause.hidden = !playing;
      toggle.setAttribute('aria-label', playing ? 'Pausar' : 'Reproducir');
    }

    function updatePressedStates(recordingAudioUrl: string | null) {
      choices.forEach(choice => {
        choice.setAttribute('aria-pressed', String(choice.dataset.radioAudio === recordingAudioUrl));
      });
      document.querySelectorAll<HTMLButtonElement>('[data-chip]').forEach(chip => {
        chip.setAttribute('aria-pressed', String(chip.dataset.chip === recordingAudioUrl));
      });
    }

    function applySearchFilter() {
      const query = searchInput.value.trim().toLowerCase();
      let visibleCuts = 0;
      for (const choice of choices) {
        const match = !query || (choice.textContent || '').toLowerCase().includes(query);
        choice.closest('li')!.hidden = !match;
        if (match) visibleCuts++;
      }
      const cutsCountEl = document.querySelector<HTMLElement>('#cuts-count-label');
      if (cutsCountEl) {
        cutsCountEl.textContent = `${visibleCuts} ${visibleCuts === 1 ? 'emisión' : 'emisiones'}`;
      }
      const recEmpty = document.querySelector<HTMLElement>('#recordings-empty-search');
      if (recEmpty) recEmpty.hidden = !(choices.length > 0 && visibleCuts === 0);

      const songRows = [...document.querySelectorAll<HTMLTableRowElement>('[data-song-row]')];
      let visibleSongs = 0;
      for (const row of songRows) {
        const match = !query || (row.textContent || '').toLowerCase().includes(query);
        row.hidden = !match;
        if (match) visibleSongs++;
      }
      const songsCountEl = document.querySelector<HTMLElement>('#songs-count-label');
      if (songsCountEl && songRows.length > 0) {
        songsCountEl.textContent = `${visibleSongs} ${visibleSongs === 1 ? 'registro' : 'registros'}`;
      }
      const songsEmpty = document.querySelector<HTMLElement>('#songs-empty-search');
      if (songsEmpty) songsEmpty.hidden = !(songRows.length > 0 && visibleSongs === 0);
    }

    function switchToPresent(autoPlay = true) {
      mode = 'live';
      activeIndex = -1;
      activeName = '';
      pendingSeek = null;
      audio.pause();
      error.hidden = true;
      setBadgeState('En directo', 'live');
      goLiveBtn.hidden = true;
      setSubtitleText(liveTrackTitle);
      setArtwork(liveTrackArt);
      progress.disabled = false;
      setProgressValue(100);
      playTime.textContent = 'En directo';
      updatePressedStates(null);

      if (autoPlay && liveStreamUrl) {
        if (wireless.isConnected()) {
          live.pause();
          audio.pause();
          wireless.syncActive(true);
          return;
        }
        setBadgeState('Conectando…', 'live');
        if (live.getAttribute('src') !== liveStreamUrl) {
          live.src = liveStreamUrl;
        }
        live.load();
        void live.play().catch(() => {
          setPlayIcon(false);
          setBadgeState('En directo', 'live');
        });
      } else {
        setPlayIcon(!live.paused);
      }
    }

    function applySeekToAudio(targetSec: number) {
      const dur = getKnownDuration();
      const clamped = dur > 0 ? Math.max(0, Math.min(targetSec, Math.max(0, dur - 0.5))) : Math.max(0, targetSec);
      pendingSeek = clamped;
      try {
        if (audio.readyState >= 1) {
          audio.currentTime = clamped;
          if (Math.abs(audio.currentTime - clamped) <= 2) {
            pendingSeek = null;
          }
        }
      } catch {}
      if (dur > 0) {
        playTime.textContent = `${clock(clamped)} / ${clock(dur)}`;
        setProgressValue((clamped / dur) * 100);
      }
    }

    function playArchive(index: number, seekOffsetSeconds = 0, customSubtitle?: string, customArt?: string) {
      if (index < 0 || !choices[index]) return;
      const button = choices[index];
      const baseAudioUrl = button.dataset.radioAudio || '';
      if (!baseAudioUrl) return;

      mode = 'archive';
      activeIndex = index;
      activeName = button.dataset.radioName || '';

      const dur = getKnownDuration(index);
      const targetOffset = dur > 0
        ? Math.max(0, Math.min(seekOffsetSeconds, Math.max(0, dur - 1)))
        : Math.max(0, seekOffsetSeconds);
      pendingSeek = targetOffset;

      live.pause();
      error.hidden = true;
      setBadgeState('Cargando…', 'archive');
      goLiveBtn.hidden = false;

      const dateText = button.dataset.radioDate || '';
      const rangeText = button.dataset.radioTime || '';
      const progName = button.dataset.radioProgram ? `${button.dataset.radioProgram} · ` : '';
      setSubtitleText(
        customSubtitle
          ? `${customSubtitle} · ${rangeText} hrs`
          : `${progName}${dateText ? dateText + ' · ' : ''}${rangeText} hrs`
      );

      setArtwork(customArt || liveTrackArt);
      progress.disabled = false;
      playTime.textContent = `${clock(targetOffset)} / ${clock(dur)}`;
      setProgressValue(dur > 0 ? (targetOffset / dur) * 100 : 0);
      updatePressedStates(baseAudioUrl);

      if (wireless.isConnected()) {
        audio.pause();
        live.pause();
        wireless.syncActive(true);
        return;
      }

      const currentBase = (audio.getAttribute('src') || '').split('#')[0];
      if (currentBase === baseAudioUrl && audio.readyState >= 1) {
        applySeekToAudio(targetOffset);
        void audio.play().catch(() => {
          if (audio.error) error.hidden = false;
        });
      } else {
        const fragment = targetOffset > 0 ? `#t=${Math.floor(targetOffset)}` : '';
        audio.src = baseAudioUrl + fragment;
        audio.load();
        const onReady = () => {
          if (pendingSeek !== null) {
            try { audio.currentTime = pendingSeek; } catch {}
          }
          void audio.play().catch(() => {
            if (audio.error) error.hidden = false;
          });
        };
        audio.addEventListener('loadedmetadata', onReady, { once: true });
      }
    }

    audio.addEventListener('canplay', () => {
      if (mode === 'archive' && pendingSeek !== null) {
        const target = pendingSeek;
        pendingSeek = null;
        try {
          if (Math.abs(audio.currentTime - target) > 2) {
            audio.currentTime = target;
          }
        } catch {}
      }
    });

    toggle.addEventListener('click', () => {
      if (mode === 'live') {
        if (live.paused) {
          if (!live.getAttribute('src') && liveStreamUrl) live.src = liveStreamUrl;
          void live.play().catch(() => {
            setBadgeState('No se pudo reproducir', 'error');
          });
        } else {
          live.pause();
        }
      } else {
        if (audio.paused) {
          void audio.play().catch(() => {
            setBadgeState('No se pudo reproducir', 'error');
          });
        } else {
          audio.pause();
        }
      }
    });

    goLiveBtn.addEventListener('click', () => switchToPresent(true));

    skipBackBtn.addEventListener('click', () => {
      if (mode === 'archive') {
        const currentPos = getGlobalCurrentTime();
        if (currentPos >= 15) {
          applySeekToAudio(currentPos - 15);
          if (audio.paused) void audio.play().catch(() => {});
        } else if (activeIndex > 0) {
          const prevIndex = activeIndex - 1;
          const prevDur = getKnownDuration(prevIndex);
          const remainder = Math.max(0, 15 - currentPos);
          playArchive(prevIndex, Math.max(0, prevDur - remainder));
        } else {
          applySeekToAudio(0);
          if (audio.paused) void audio.play().catch(() => {});
        }
      } else {
        if (!live.paused && live.currentTime >= 15) {
          try {
            live.currentTime = Math.max(0, live.currentTime - 15);
            setBadgeState('En directo (-15 s)', 'archive');
            goLiveBtn.hidden = false;
            setProgressValue(85);
            return;
          } catch {}
        }
        if (choices.length > 0) {
          const latestIndex = choices.length - 1;
          const latestDur = getKnownDuration(latestIndex);
          playArchive(latestIndex, Math.max(0, latestDur - 15));
        }
      }
    });

    skipForwardBtn.addEventListener('click', () => {
      if (mode === 'archive') {
        const dur = getKnownDuration();
        const currentPos = getGlobalCurrentTime();
        if (dur > 0 && currentPos + 15 < dur - 1) {
          applySeekToAudio(currentPos + 15);
          if (audio.paused) void audio.play().catch(() => {});
        } else if (activeIndex >= 0 && activeIndex + 1 < choices.length) {
          playArchive(activeIndex + 1, 0);
        } else {
          switchToPresent(true);
        }
      } else if (!live.paused && live.buffered.length > 0) {
        const bufferedEnd = live.buffered.end(live.buffered.length - 1);
        if (bufferedEnd - live.currentTime > 2) {
          live.currentTime = Math.min(bufferedEnd - 0.5, live.currentTime + 15);
          if (bufferedEnd - live.currentTime <= 2) {
            setBadgeState('En directo', 'live');
            goLiveBtn.hidden = true;
            setProgressValue(100);
          }
        }
      }
    });

    progress.addEventListener('input', () => {
      isScrubbing = true;
      const val = Number(progress.value);
      setProgressValue(val);
      if (mode === 'archive') {
        const dur = getKnownDuration();
        if (dur > 0) {
          const previewSec = (val / 100) * dur;
          playTime.textContent = `${clock(previewSec)} / ${clock(dur)}`;
        }
      } else {
        if (val < 96 && choices.length > 0) {
          const latestIndex = choices.length - 1;
          const latestDur = getKnownDuration(latestIndex);
          const targetSec = (val / 100) * latestDur;
          playTime.textContent = `${clock(targetSec)} / ${clock(latestDur)}`;
        } else {
          playTime.textContent = 'En directo';
        }
      }
    });

    progress.addEventListener('change', () => {
      isScrubbing = false;
      const val = Number(progress.value);
      if (mode === 'archive') {
        const dur = getKnownDuration();
        if (dur > 0) {
          applySeekToAudio((val / 100) * dur);
          if (audio.paused) void audio.play().catch(() => {});
        }
      } else {
        if (val < 96 && choices.length > 0) {
          const latestIndex = choices.length - 1;
          const latestDur = getKnownDuration(latestIndex);
          const targetSec = (val / 100) * latestDur;
          playArchive(latestIndex, targetSec);
        } else {
          setProgressValue(100);
          playTime.textContent = 'En directo';
        }
      }
    });

    function applyVolume(vol: number) {
      const clamped = Math.max(0, Math.min(1, vol));
      audio.volume = clamped;
      live.volume = clamped;
      volumeInput.value = String(clamped);
      volumeInput.style.setProperty('--vol', `${Math.round(clamped * 100)}%`);
      const isMuted = clamped === 0;
      volIconOn.hidden = isMuted;
      volIconMute.hidden = !isMuted;
    }

    volumeInput.addEventListener('input', event => {
      const val = Number((event.target as HTMLInputElement).value);
      if (val > 0) lastVolume = val;
      applyVolume(val);
    });

    muteBtn.addEventListener('click', () => {
      if (audio.volume > 0) {
        lastVolume = audio.volume;
        applyVolume(0);
      } else {
        applyVolume(lastVolume || 1);
      }
    });

    live.addEventListener('play', () => {
      audio.pause();
      if (mode === 'live') {
        setPlayIcon(true);
        setBadgeState('En directo', 'live');
      }
    });
    live.addEventListener('playing', () => {
      if (mode === 'live') {
        setPlayIcon(true);
        setBadgeState('En directo', 'live');
      }
    });
    live.addEventListener('waiting', () => {
      if (mode === 'live') setBadgeState('Cargando…', 'live');
    });
    live.addEventListener('pause', () => {
      if (mode === 'live') {
        setPlayIcon(false);
        setBadgeState('Pausado', 'paused');
      }
    });
    live.addEventListener('error', () => {
      if (mode === 'live') {
        setPlayIcon(false);
        setBadgeState('En directo', 'live');
      }
    });

    audio.addEventListener('play', () => {
      live.pause();
      if (mode === 'archive') {
        setPlayIcon(true);
        setBadgeState('Reproduciendo', 'archive');
      }
    });
    audio.addEventListener('playing', () => {
      if (mode === 'archive') {
        setPlayIcon(true);
        setBadgeState('Reproduciendo', 'archive');
      }
    });
    audio.addEventListener('waiting', () => {
      if (mode === 'archive') setBadgeState('Cargando…', 'archive');
    });
    audio.addEventListener('pause', () => {
      if (mode === 'archive') {
        setPlayIcon(false);
        setBadgeState('Pausado', 'paused');
      }
    });
    audio.addEventListener('error', () => {
      if (mode === 'archive') {
        setPlayIcon(false);
        error.hidden = false;
        setBadgeState('Error de audio', 'error');
      }
    });
    audio.addEventListener('timeupdate', () => {
      if (mode !== 'archive' || isScrubbing) return;
      const cur = getGlobalCurrentTime();
      const dur = getKnownDuration();
      playTime.textContent = `${clock(cur)} / ${clock(dur)}`;
      if (dur > 0) setProgressValue((cur / dur) * 100);
    });
    audio.addEventListener('ended', () => {
      if (activeIndex >= 0 && activeIndex + 1 < choices.length) {
        playArchive(activeIndex + 1, 0);
      } else {
        switchToPresent(true);
      }
    });

    shareBtn.addEventListener('click', async () => {
      const shareUrl = new URL(location.href);
      if (mode === 'archive' && activeName) {
        shareUrl.searchParams.set('corte', activeName);
        if (audio.currentTime > 2) shareUrl.searchParams.set('t', String(Math.floor(audio.currentTime)));
      } else {
        shareUrl.searchParams.delete('corte');
        shareUrl.searchParams.delete('t');
      }
      try {
        await navigator.clipboard.writeText(shareUrl.href);
        shareIconLink.hidden = true;
        shareIconCheck.hidden = false;
        shareBtn.title = 'Enlace copiado';
        shareBtn.setAttribute('aria-label', 'Enlace copiado');
        if (shareResetTimer) window.clearTimeout(shareResetTimer);
        shareResetTimer = window.setTimeout(() => {
          shareIconLink.hidden = false;
          shareIconCheck.hidden = true;
          shareBtn.title = 'Copiar enlace';
          shareBtn.setAttribute('aria-label', 'Copiar enlace');
        }, 2200);
      } catch {
        shareBtn.title = 'Copia la URL desde la barra de direcciones';
      }
    });

    searchInput.addEventListener('input', () => applySearchFilter());

    document.addEventListener('click', event => {
      const target = event.target as Element;

      const button = target.closest<HTMLButtonElement>('[data-radio-audio]');
      if (button) {
        playArchive(choices.indexOf(button), 0);
        return;
      }

      const chip = target.closest<HTMLButtonElement>('[data-chip]');
      if (chip) {
        const index = choices.findIndex(choice => choice.dataset.radioAudio === chip.dataset.chip);
        if (index >= 0) playArchive(index, 0);
        return;
      }

      const seekBtn = target.closest<HTMLButtonElement>('[data-seek-audio]');
      if (seekBtn) {
        const audioTarget = seekBtn.dataset.seekAudio || '';
        const offset = Number(seekBtn.dataset.seekOffset) || 0;
        const songTitle = seekBtn.dataset.seekTitle || '';
        const songArt = seekBtn.dataset.seekArt || '';
        const match = findGroupForRecording(audioTarget);
        if (match) {
          playArchive(match.groupIndex, match.segOffsetStart + offset, songTitle, songArt);
        }
        return;
      }

      const triggerLive = target.closest<HTMLButtonElement>('[data-trigger-live]');
      if (triggerLive) {
        switchToPresent(true);
        return;
      }

      const day = target.closest<HTMLAnchorElement>('.radio-days a');
      if (day) {
        event.preventDefault();
        void changeDate(new URL(day.href).searchParams.get('fecha') || '');
      }
    });

    async function changeDate(date: string, push = true) {
      const currentDateInput = document.querySelector<HTMLInputElement>('#radio-date');
      const minDate = currentDateInput?.dataset.min || currentDateInput?.min || '';
      const maxDate = currentDateInput?.dataset.max || currentDateInput?.max || '';
      if (!currentDateInput || !date || (minDate && date < minDate) || (maxDate && date > maxDate)) return;
      const url = new URL(location.href);
      url.searchParams.set('fecha', date);
      url.searchParams.delete('corte');
      url.searchParams.delete('t');
      try {
        const response = await fetch(url, { headers: { Accept: 'text/html' } });
        if (!response.ok) throw new Error('date');
        const page = new DOMParser().parseFromString(await response.text(), 'text/html');

        const currentExplorer = document.querySelector('.explorer');
        const replacementExplorer = page.querySelector('.explorer');
        if (!currentExplorer || !replacementExplorer) return;
        currentExplorer.innerHTML = replacementExplorer.innerHTML;

        const songsSection = page.querySelector('#canciones') as HTMLElement | null;
        const localSongs = document.querySelector<HTMLElement>('#canciones');
        if (songsSection && localSongs) {
          localSongs.innerHTML = songsSection.innerHTML;
          localSongs.hidden = songsSection.hidden;
        }
        const recSchedule = page.querySelector('#horario-grabaciones') as HTMLElement | null;
        const localRecSchedule = document.querySelector<HTMLElement>('#horario-grabaciones');
        if (recSchedule && localRecSchedule) {
          localRecSchedule.innerHTML = recSchedule.innerHTML;
          localRecSchedule.hidden = recSchedule.hidden;
        }

        choices = [...document.querySelectorAll<HTMLButtonElement>('[data-radio-audio]')];
        updatePressedStates(mode === 'archive' && choices[activeIndex] ? choices[activeIndex].dataset.radioAudio || null : null);
        applySearchFilter();
        if (push) history.pushState({}, '', url);
      } catch {
        location.href = url.href;
      }
    }

    document.addEventListener('change', event => {
      const input = event.target as HTMLInputElement;
      if (input.id === 'radio-date') void changeDate(input.value);
    });

    document.addEventListener('click', event => {
      const btn = (event.target as Element).closest<HTMLButtonElement>('button');
      if (!btn || (btn.id !== 'previous-day' && btn.id !== 'next-day') || btn.disabled) return;
      const input = document.querySelector<HTMLInputElement>('#radio-date');
      if (!input) return;
      const day = new Date(input.value + 'T12:00:00Z');
      day.setUTCDate(day.getUTCDate() + (btn.id === 'previous-day' ? -1 : 1));
      void changeDate(day.toISOString().slice(0, 10));
    });

    window.addEventListener('popstate', () => {
      const input = document.querySelector<HTMLInputElement>('#radio-date');
      void changeDate(new URL(location.href).searchParams.get('fecha') || input?.dataset.max || '', false);
    });

    function escapeHtml(str: string) {
      return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
    }

    function renderSongsTable(songs: any[]) {
      const songsCard = document.querySelector<HTMLElement>('#canciones');
      const recCard = document.querySelector<HTMLElement>('#horario-grabaciones');
      const tbody = document.querySelector<HTMLElement>('#songs-tbody');
      const mobileSongsLink = document.querySelector<HTMLAnchorElement>('#mobile-songs-link');
      if (!tbody) return;
      if (!Array.isArray(songs) || !songs.length) {
        if (songsCard) songsCard.hidden = true;
        if (recCard) recCard.hidden = false;
        if (mobileSongsLink) mobileSongsLink.setAttribute('href', '#horario-grabaciones');
        return;
      }
      if (songsCard) songsCard.hidden = false;
      if (recCard) recCard.hidden = true;
      if (mobileSongsLink) mobileSongsLink.setAttribute('href', '#canciones');
      tbody.innerHTML = songs.map(song => {
        const artist = song.artist || stationFallbackName;
        const durLabel = song.duration > 0 ? clock(song.duration) : '—';
        const seekTitle = `${song.artist ? song.artist + ' — ' : ''}${song.title}`;
        let actionHtml = '<span class="no-archive-tag">Sin corte</span>';
        if (song.recording) {
          actionHtml = `<button type="button" class="button small song-seek-btn" data-seek-audio="${escapeHtml(song.recording.url)}" data-seek-offset="${Number(song.recording.offset) || 0}" data-seek-title="${escapeHtml(seekTitle)}" data-seek-art="${escapeHtml(song.art || '')}"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 4l13 8-13 8z"/></svg><span>${escapeHtml(song.recording.range)}</span></button>`;
        } else if (song.isCurrent) {
          actionHtml = `<button type="button" class="button small song-seek-btn" data-trigger-live="true"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 8a6 6 0 0 0 0 8 M16 8a6 6 0 0 1 0 8 M4 4a12 12 0 0 0 0 16 M20 4a12 12 0 0 1 0 16 M12 10a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/></svg><span>En directo</span></button>`;
        }
        return `<tr data-song-row data-has-recording="${song.recording ? 'true' : 'false'}" data-recording-name="${escapeHtml(song.recording?.name || '')}" data-played-at="${Number(song.playedAt) || 0}">
          <td class="song-time-cell"><span>${escapeHtml(song.time)}</span>${song.isCurrent ? '<span class="song-live-pill">Ahora</span>' : ''}</td>
          <td class="song-title-td"><div class="song-title-cell">${song.art ? `<img src="${escapeHtml(song.art)}" alt="" class="song-thumb" loading="lazy"/>` : ''}<strong title="${escapeHtml(song.title)}">${escapeHtml(song.title)}</strong></div></td>
          <td class="song-artist-td" title="${escapeHtml(artist)}">${escapeHtml(artist)}</td>
          <td class="song-duration-cell">${durLabel}</td>
          <td class="song-action-td">${actionHtml}</td>
        </tr>`;
      }).join('');
      applySearchFilter();
    }

    async function refreshStationStatus() {
      try {
        const currentFecha = document.querySelector<HTMLInputElement>('#radio-date')?.value || '';
        const res = await fetch(`${radioPath}status.json?fecha=${encodeURIComponent(currentFecha)}`, {
          headers: { Accept: 'application/json' },
        });
        if (!res.ok) return;
        const data = await res.json();
        if (data.station) {
          if (data.station.listenUrl) {
            liveStreamUrl = data.station.listenUrl;
            if (!live.getAttribute('src')) live.src = liveStreamUrl;
          }
          if (data.station.liveTitle || data.station.nowPlaying) {
            const np = data.station.nowPlaying;
            liveTrackTitle = data.station.liveTitle || (np ? `${np.artist ? np.artist + ' — ' : ''}${np.title}` : 'Señal en directo');
            liveTrackArt = np?.art || '';
            if (mode === 'live') {
              setSubtitleText(liveTrackTitle);
              setArtwork(liveTrackArt);
            }
          }
        }
        if (Array.isArray(data.groups) && data.groups.length > 0 && choices.length > 0) {
          const latestGroup = data.groups[data.groups.length - 1];
          const latestChoice = choices[choices.length - 1];
          if (latestChoice && Number(latestChoice.dataset.radioStart) === latestGroup.start) {
            if (latestGroup.url) latestChoice.dataset.radioAudio = latestGroup.url;
            latestChoice.dataset.radioEnd = String(latestGroup.end);
            latestChoice.dataset.radioDuration = String(latestGroup.totalSeconds);
            latestChoice.dataset.radioTime = latestGroup.range;
            latestChoice.dataset.segments = JSON.stringify(latestGroup.segments);
            const durText = formatDurationLabel(latestGroup.totalSeconds);
            const timePrimary = latestChoice.querySelector('.segment-time-primary');
            if (timePrimary) timePrimary.textContent = `${latestGroup.range} hrs`;
            const durSmall = latestChoice.querySelector('.segment-duration');
            if (durSmall) durSmall.textContent = durText;
            const timeSmall = latestChoice.querySelector('.segment-time');
            if (timeSmall) timeSmall.textContent = `${latestGroup.range} hrs · ${durText}`;
          }
        }
        if (Array.isArray(data.songs)) {
          renderSongsTable(data.songs);
        }
      } catch {}
    }

    const initialParams = new URL(location.href).searchParams;
    const requestedCut = initialParams.get('corte');
    const requestedOffset = Number(initialParams.get('t')) || 0;
    if (requestedCut) {
      const match = findGroupForRecording(requestedCut);
      if (match) {
        playArchive(match.groupIndex, match.segOffsetStart + requestedOffset);
      } else {
        switchToPresent(false);
      }
    } else {
      switchToPresent(false);
    }

    setInterval(refreshStationStatus, 15_000);
  </script>
</body>
</html>

