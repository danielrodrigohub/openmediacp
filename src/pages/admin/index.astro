---
import Panel from '../../layouts/Panel.astro';
import Icon from '../../components/Icon.astro';
import {db} from '../../server/db';
const channels=Astro.locals.channels;
const clients=(db.prepare("SELECT count(*) AS total FROM users WHERE role='client'").get() as {total:number}).total;
const assets=(db.prepare('SELECT count(*) AS total FROM assets').get() as {total:number}).total;
const owners=db.prepare('SELECT id,username FROM users').all() as {id:number;username:string}[];
---
<Panel title="Resumen" admin>
<div class="summary-grid"><a class="summary-tile" href="/admin/servicios/"><span class="summary-icon"><Icon name="video" size={23}/></span><div><p>Canales de video</p><strong>{channels.length}</strong><small>Servicios registrados</small></div></a><a class="summary-tile" href="/admin/clientes/"><span class="summary-icon mint"><Icon name="users" size={23}/></span><div><p>Cuentas de cliente</p><strong>{clients}</strong><small>Clientes de la plataforma</small></div></a><div class="summary-tile"><span class="summary-icon sand"><Icon name="folder" size={23}/></span><div><p>Videos alojados</p><strong>{assets}</strong><small>En todas las bibliotecas</small></div></div></div>
<section class="card"><div class="card-heading"><h2>Tus canales</h2><a class="button primary small" href="/admin/servicios/"><Icon name="video" size={15}/>Crear servicio</a></div>{channels.length?<div class="table-wrap admin-table"><table><thead><tr><th>Canal</th><th>Propietario</th><th>Estado de salida</th><th>Respaldo configurado</th><th>Administrar</th></tr></thead><tbody>{channels.map(c=><tr><td><span class="file-name"><Icon name="video" size={18}/><strong>{c.name}</strong></span></td><td>{owners.find(u=>u.id===c.owner_id)?.username}</td><td><span class="badge gray">Sin datos</span></td><td><span class="badge blue">{JSON.parse(c.fallback).length?`${JSON.parse(c.fallback).length} videos`:'Cartela de emergencia'}</span></td><td><a class="text-link" href={`/cliente/?channel=${c.id}`}>Operar canal <Icon name="arrow" size={14}/></a></td></tr>)}</tbody></table></div>:<div class="empty-state"><Icon name="server" size={38}/><h2>Todo listo para tu primer canal.</h2><p>Crea una cuenta de cliente y asígnale un servicio. Desde su estación podrá preparar el respaldo y conectar el directo.</p><div class="button-row"><a class="button primary" href="/admin/clientes/">Crear cliente <Icon name="arrow" size={15}/></a><a class="button" href="/admin/servicios/">Crear servicio</a></div></div>}</section>

</Panel>
