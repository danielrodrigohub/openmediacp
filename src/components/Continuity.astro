---
import Icon from './Icon.astro';
import SignalStatus from './SignalStatus.astro';
import type {Channel} from '../server/config';
import type {SignalSnapshot} from '../server/signal';
import {defaultAutoDJ} from '../server/playlist';
import {mediaDuration,type MediaAsset} from '../lib/media';
interface Props{channel:Channel;assets:(MediaAsset&{available:boolean})[];signal:SignalSnapshot}
const {channel,assets,signal}=Astro.props;
const ids:string[]=JSON.parse(channel.fallback),policy={...defaultAutoDJ,...JSON.parse(channel.autodj||'{}')};
const videos=ids.map(id=>assets.find(a=>a.id===id));const absent=videos.filter(a=>!a?.available).length;const unknown=videos.filter(a=>!a?.duration).length;const total=videos.reduce((sum,a)=>sum+(a?.duration||0),0);
---
<SignalStatus signal={signal}/>
<div class="continuity-steps"><section class="continuity-step"><span class="step-index">PRIORIDAD 01</span><Icon name="broadcast" size={26}/><h2>Directo</h2><p>La entrada en vivo tiene prioridad cuando está disponible.</p><span class="badge gray">Fuente activa: sin datos</span></section><section class="continuity-step"><span class="step-index">PRIORIDAD 02</span><Icon name="list" size={26}/><h2>Playlist de respaldo</h2><p>El contenido preparado se utiliza cuando falta la fuente en vivo.</p><span class:list={['badge',ids.length&&!absent?'blue':'amber']}>{ids.length?`${ids.length} videos seleccionados`:'Sin videos seleccionados'}</span></section><section class="continuity-step"><span class="step-index">PRIORIDAD 03</span><Icon name="shield" size={26}/><h2>Cartela de emergencia</h2><p>Se utiliza cuando no hay directo ni contenido de respaldo disponible.</p><span class="badge gray">Cartela del sistema</span></section></div>
<div class="two-columns"><section class="card"><div class="card-heading"><h2>Playlist preparada</h2></div><div class="card-body form-fields">{(!ids.length||absent>0)&&<div class="notice"><Icon name="info" size={20}/>{absent?`${absent} archivos no están disponibles. Revisa la selección de respaldo.`:'No has seleccionado videos. El canal utilizará la cartela de emergencia.'}</div>}<dl class="detail-list"><div><dt>Videos seleccionados</dt><dd>{ids.length}</dd></div><div><dt>Duración conocida</dt><dd>{total?mediaDuration(total):'No disponible'}{unknown?` · ${unknown} sin duración`:''}</dd></div><div><dt>Orden</dt><dd>{policy.shuffle?'Aleatorio':'Orden de la playlist'}</dd></div><div><dt>Volver a barajar</dt><dd>{policy.reshuffle?'Al terminar cada ciclo':'Desactivado'}</dd></div><div><dt>Separadores</dt><dd>{policy.every&&policy.separatorIds.length?`Cada ${policy.every} videos`:'Sin intercalar'}</dd></div></dl><div><a class="button primary" href={`/cliente/playlists/?channel=${channel.id}`}>Editar playlist <Icon name="arrow" size={17}/></a></div></div></section><section class="card"><div class="card-heading"><h2>Retorno al directo</h2></div><div class="card-body form-fields"><p>Cuando vuelve a estar disponible, la entrada en vivo recupera la prioridad. La audiencia utiliza la misma URL de reproducción.</p><p class="hint">Los cambios de fuente pueden necesitar unos segundos de buffer. No se garantiza una transición imperceptible.</p><a class="text-link" href={`/cliente/archivos/?channel=${channel.id}`}>Revisar biblioteca <Icon name="arrow" size={16}/></a></div></section></div>
