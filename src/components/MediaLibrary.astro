---
import Icon from './Icon.astro';
import UploadQueue from './UploadQueue.astro';
import {mediaSize,mediaDuration,type MediaAsset} from '../lib/media';
interface Props{assets:(MediaAsset&{available:boolean})[];folders:string[];folder:string;owner:number;channel:string;quota:number}
const {assets,folders,folder,owner,channel,quota}=Astro.props;
const current=assets.filter(a=>a.folder===folder),bytes=assets.reduce((n,a)=>n+a.bytes,0);
const url=(path:string)=>`/cliente/archivos/?channel=${channel}&folder=${encodeURIComponent(path)}`;
---
<div class="storage-band" data-library-storage><strong>Almacenamiento</strong><progress max={quota} value={Math.min(bytes,quota)} aria-label="Almacenamiento utilizado"></progress><span>{mediaSize(bytes)} de {mediaSize(quota)}</span><span>{assets.length} videos</span></div>
<section class="card" data-library data-channel={channel}><div class="toolbar"><div class="file-name"><Icon name="folder" size={23}/><a href={url('')}>Biblioteca</a><span class="muted">/</span><strong>{folder||'Todos los archivos'}</strong></div><div class="toolbar-actions"><label class="search-field"><Icon name="search" size={18}/><input type="search" data-library-search placeholder="Buscar videos o carpetas" aria-label="Buscar videos o carpetas en esta carpeta"/></label><select class="select-field" data-library-type aria-label="Filtrar tipo"><option value="all">Tipo: todos</option><option value="video">Videos</option><option value="folder">Carpetas</option></select><button class="button outline" type="button" data-open-dialog="new-folder"><Icon name="folder" size={19}/>Nueva carpeta</button></div></div>
{folder&&<div class="toolbar"><a class="text-link" href={url(folder.includes('/')?folder.slice(0,folder.lastIndexOf('/')):'')}><Icon name="up" size={16}/>Carpeta superior</a></div>}
<div class="bulk-toolbar" data-library-selection hidden><strong data-selection-count></strong><a class="button primary small" data-add-selected><Icon name="list" size={18}/>Añadir a playlist</a></div>
<div class="table-wrap"><table class="library-table"><thead><tr><th class="selection-cell"><input type="checkbox" data-select-page aria-label="Seleccionar videos de esta página"/></th><th><button class="icon-button bare" type="button" data-sort-library aria-label="Cambiar orden por nombre">Nombre <Icon name="up" size={15}/></button></th><th>Tamaño</th><th>Duración</th><th>Estado</th><th>Añadido</th><th>Acciones</th></tr></thead><tbody data-library-rows>
{folders.map(path=><tr class="folder-row" data-kind="folder" data-name={path.split('/').at(-1)}><td class="selection-cell"></td><td class="name-cell"><a class="file-name" href={url(path)}><span class="folder-icon"><Icon name="folder" size={29}/></span><span class="file-info"><strong title={path}>{path.split('/').at(-1)}</strong></span></a></td><td class="secondary-cell">—</td><td class="secondary-cell">—</td><td class="secondary-cell"></td><td class="secondary-cell">—</td><td class="table-actions"><details class="row-menu"><summary aria-label={`Acciones de ${path}`}><Icon name="more" size={21}/></summary><div class="user-popover"><a href={url(path)}>Abrir carpeta</a></div></details></td></tr>)}
{current.map(a=><tr data-kind="video" data-name={a.name} data-id={a.id}><td class="selection-cell"><input type="checkbox" value={a.id} data-select-asset disabled={!a.available} aria-label={`Seleccionar ${a.name}`}/></td><td class="name-cell"><span class="file-name"><button class="media-thumb asset-preview-button" type="button" data-preview-asset disabled={!a.available} aria-label={`Previsualizar ${a.name}`}><Icon name="video" size={22}/>{a.available&&<img alt="" loading="lazy" decoding="async" data-thumbnail={`/api/assets/${a.id}?thumbnail=1`} hidden/>}</button><span class="file-info"><strong title={a.name}>{a.name}</strong>{a.folder&&<small>{a.folder}</small>}</span></span></td><td class="secondary-cell">{mediaSize(a.bytes)}</td><td class="secondary-cell">{mediaDuration(a.duration)}</td><td class="mobile-state"><span class:list={['badge',a.available?'green':'red']}><span class="badge-dot"></span>{a.available?'Disponible':'No disponible'}</span></td><td class="secondary-cell">{new Date(a.created_at).toLocaleDateString('es-CL',{timeZone:'America/Santiago',day:'2-digit',month:'short',year:'numeric'})}</td><td class="table-actions"><details class="row-menu"><summary aria-label={`Acciones de ${a.name}`}><Icon name="more" size={21}/></summary><div class="user-popover">{a.available?<a href={`/cliente/playlists/?channel=${channel}&add=${a.id}`}>Añadir a playlist</a>:<span class="hint">El archivo no está disponible.</span>}</div></details></td></tr>)}
</tbody></table><p class="empty-search" data-library-empty hidden>No hay elementos para mostrar en esta carpeta.</p></div><div class="table-pagination"><span data-library-count>Mostrando {folders.length+current.length} elementos</span><div class="pagination-actions"><button type="button" class="button small" data-library-prev aria-label="Página anterior">‹</button><span class="badge blue" data-library-page>1</span><button type="button" class="button small" data-library-next aria-label="Página siguiente">›</button></div></div></section>
<dialog class="dialog" id="new-folder"><div class="card-heading"><h2>Nueva carpeta</h2><button class="icon-button bare" type="button" data-close-dialog aria-label="Cerrar"><Icon name="close"/></button></div><form data-api-form="/api/assets/folders" data-reload data-folder-parent={folder}><div class="card-body form-fields"><input type="hidden" name="owner" value={owner}/><input type="hidden" name="channel" value={channel}/><p class="hint">Ubicación: Biblioteca{folder?` / ${folder}`:''}</p><label>Nombre de la carpeta<input name="path" required maxlength="180" autocomplete="off"/></label><div data-form-result role="status" aria-live="polite"></div></div><div class="form-footer"><button class="button" type="button" data-close-dialog>Cancelar</button><button class="button primary" type="submit">Crear carpeta</button></div></form></dialog>
<dialog class="dialog asset-preview-dialog" data-asset-preview aria-labelledby="asset-preview-title"><div class="card-heading"><h2 id="asset-preview-title">Vista previa del video</h2><button class="icon-button bare" type="button" data-close-dialog aria-label="Cerrar vista previa"><Icon name="close"/></button></div><div class="asset-preview-screen"></div><p class="hint" role="status" data-preview-status></p></dialog>
<p role="status" class="hint" data-library-refresh-status hidden></p>
<UploadQueue channel={channel} quota={quota} folder={folder}/>
<script>import '../scripts/library';</script>
