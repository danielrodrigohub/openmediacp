---
import {
  chileClock,
  defaultStationApiUrl,
  formatClipFilename,
  formatProgramDaysLabel,
  groupRecordingsForDisplay,
  parseStationData,
  programsForChannel,
  radioDate,
  radioDays,
  radioHour,
  radioSettings,
  recordingsFor,
  resolveLiveDisplayTitle,
  songsForDate,
  syncStationApi,
} from '../server/radio';
import Icon from './Icon.astro';
import type { Channel } from '../server/config';

interface Props { channel: Channel }
const { channel } = Astro.props;
let settings = radioSettings(channel.id);
const apiUrl = settings?.station_api_url || '';
const station = apiUrl ? await syncStationApi(channel.id, apiUrl) : {};
settings = radioSettings(channel.id);
const stationInfo = Object.keys(station).length ? station : parseStationData(settings?.station_data);

const programs = programsForChannel(channel.id);
const liveStatus = resolveLiveDisplayTitle(stationInfo, programs);
const allRecordings = recordingsFor(channel.id);
const days = radioDays();
const today = days[0];

const formatTotalDuration = (seconds: number) => {
  const totalSec = Math.max(1, Math.round(seconds));
  if (totalSec < 60) return `${totalSec} s`;
  const totalMins = Math.round(totalSec / 60);
  if (totalMins < 60) return `${totalMins} min`;
  const hrs = Math.floor(totalMins / 60);
  const mins = totalMins % 60;
  return mins > 0 ? `${hrs} h ${mins} min` : `${hrs} h`;
};

const groupedEmissions = days.flatMap(d => {
  const dayRecs = allRecordings.filter(r => radioDate(r.start) === d);
  return groupRecordingsForDisplay(dayRecs, programs).reverse().map(group => {
    const startHhmm = radioHour(group.start);
    const endHhmm = radioHour(group.end) === startHhmm ? radioHour(group.start + 60_000) : radioHour(group.end);
    const audioUrl = group.segments.length > 1
      ? `/api/admin/radio/${channel.id}?action=merged&fecha=${encodeURIComponent(d)}&grupo=${encodeURIComponent(group.id)}`
      : `/api/admin/radio/${channel.id}?action=audio&recording=${encodeURIComponent(group.segments[0].name)}`;
    return {
      ...group,
      dateStr: d,
      startHhmm,
      endHhmm,
      durationLabel: formatTotalDuration(group.totalSeconds),
      audioUrl,
      programSlug: group.programName || stationInfo.name || channel.name,
    };
  });
});

const recentSongs = apiUrl
  ? days.flatMap(d => {
      const dayRecs = allRecordings.filter(r => radioDate(r.start) === d);
      const dayGroups = groupedEmissions.filter(g => g.dateStr === d);
      return songsForDate(channel.id, d, dayRecs, stationInfo.now_playing?.played_at).map(s => {
        let groupId = '';
        let groupOffset = 0;
        if (s.recording) {
          for (const g of dayGroups) {
            let acc = 0;
            for (const seg of g.segments) {
              if (seg.name === s.recording.name) {
                groupId = g.id;
                groupOffset = Math.round(acc + s.recording.offset);
                break;
              }
              acc += Math.max(1, (seg.end - seg.start) / 1000);
            }
            if (groupId) break;
          }
        }
        return {
          ...s,
          dateStr: d,
          groupId,
          groupOffset,
          clipDur: Math.max(30, s.duration || 210),
          startHhmm: radioHour(s.played_at * 1000),
        };
      });
    }).slice(0, 60)
  : [];

const canEdit = Astro.locals.user?.role === 'admin';
const recent = settings && Date.now() - settings.updated_at < 10 * 60_000;
const states: Record<string, string> = {
  connecting: 'Conectando',
  recording: 'Grabación activa',
  reconnecting: 'Reintentando fuente',
  disk_full: 'Sin espacio en disco',
  waiting: 'Grabador listo',
};
const state = !channel.enabled
  ? 'Canal desactivado'
  : !settings?.recording
    ? 'Grabación desactivada'
    : (recent && states[settings.state]) || states[settings.state] || states.waiting;

const stateTone = !channel.enabled || !settings?.recording
  ? 'gray'
  : settings.state === 'recording'
    ? 'green'
    : settings.state === 'disk_full'
      ? 'red'
      : 'amber';

const effectiveStream = settings?.source_url || stationInfo.listen_url || '';
const nowClock = chileClock();
const latestEmission = groupedEmissions[0];
const defaultClipDate = latestEmission?.dateStr || today;
const defaultClipStart = latestEmission?.startHhmm || '08:00';
const defaultClipProg = liveStatus.activeProgram?.name
  || latestEmission?.programName
  || stationInfo.name
  || channel.name;
const defaultFilenamePreview = formatClipFilename(defaultClipDate, defaultClipStart, defaultClipProg);

const formatSongDuration = (seconds: number) => {
  if (!seconds || seconds <= 0) return '—';
  return `${Math.floor(seconds / 60)}:${Math.floor(seconds % 60).toString().padStart(2, '0')}`;
};
const isPublished = settings?.published === 1 && channel.enabled === 1;
---
<div class="radio-admin-workspace" data-channel-id={channel.id}>
  <!-- Franja operativa compacta -->
  <div class="signal-strip radio-status-strip">
    <span class:list={['badge', stateTone]}>
      <span class="badge-dot" aria-hidden="true"></span>
      {state}
    </span>
    <span class="strip-item strip-now" title={liveStatus.title}>
      <strong>Al aire:</strong> {liveStatus.title}
      {typeof stationInfo.listeners === 'number' && <small>({stationInfo.listeners} oyentes)</small>}
    </span>
    <span class="strip-item">
      {groupedEmissions.length} {groupedEmissions.length === 1 ? 'emisión' : 'emisiones'} · {programs.length} {programs.length === 1 ? 'programa' : 'programas'}
    </span>
    {isPublished ? (
      <a class="text-link strip-action" href={`/radio/${channel.id}/`} target="_blank" rel="noopener">
        Abrir página pública <Icon name="external" size={14}/>
      </a>
    ) : (
      <span class="checked-time">Chile {nowClock.hhmm} hrs</span>
    )}
  </div>

  <div class="radio-admin-columns">
    <!-- COLUMNA IZQUIERDA: Recortador MP3 y Programas -->
    <div class="radio-admin-col">
      <!-- 1. Recortar y descargar MP3 -->
      <section class="card">
        <div class="card-heading">
          <h2>Recortar audio MP3</h2>
          <span class="heading-meta">128 kbps · Hora Chile</span>
        </div>
        <div class="card-body clipper-body">
          {groupedEmissions.length ? (
            <form id="radio-clip-form" data-clip-endpoint={`/api/admin/radio/${channel.id}`}>
              <div class="clipper-top-grid">
                <label>
                  Emisión a recortar
                  <select id="clip-emission-select" class="field-input">
                    {groupedEmissions.map((em, idx) => (
                      <option
                        value={em.id}
                        selected={idx === 0}
                        data-date={em.dateStr}
                        data-start={em.startHhmm}
                        data-end={em.endHhmm}
                        data-duration={Math.round(em.totalSeconds)}
                        data-program={em.programSlug}
                        data-audio={em.audioUrl}
                      >
                        {em.dateStr === today ? 'Hoy' : em.dateStr} · {em.startHhmm} – {em.endHhmm} hrs{em.programName ? ` · ${em.programName}` : ''} ({em.durationLabel})
                      </option>
                    ))}
                  </select>
                </label>

                <label>
                  Nombre del archivo
                  <input
                    type="text"
                    id="clip-program"
                    class="field-input"
                    maxlength="50"
                    list="channel-programs-list"
                    value={defaultClipProg}
                    placeholder="Ej: Matinal"
                    required
                  />
                  <datalist id="channel-programs-list">
                    {programs.map(p => <option value={p.name}/>)}
                  </datalist>
                </label>
              </div>

              <audio
                id="admin-preview-audio"
                preload="metadata"
                src={latestEmission ? latestEmission.audioUrl : undefined}
              ></audio>

              <div class="trimmer-box" id="trimmer-box">
                <div class="trimmer-transport">
                  <button type="button" class="button small" id="trim-play-btn" aria-label="Reproducir o pausar">
                    <span id="trim-icon-play"><Icon name="play" size={14}/></span>
                    <span id="trim-icon-pause" hidden><Icon name="pause" size={14}/></span>
                    <span id="trim-play-label">Escuchar</span>
                  </button>
                  <button type="button" class="button small" id="trim-back-10" title="Retroceder 10 segundos">-10 s</button>
                  <button type="button" class="button small" id="trim-fwd-10" title="Avanzar 10 segundos">+10 s</button>
                  <button type="button" class="button small outline" id="trim-preview-selection">
                    Escuchar recorte
                  </button>
                  <span class="trim-clock tabular-cell" id="trim-current-clock">0:00 / 0:00</span>
                </div>

                <div class="trim-timeline-wrap">
                  <div class="trim-track" id="trim-track" role="group" aria-label="Línea de tiempo del recorte">
                    <div class="trim-selection" id="trim-selection"></div>
                    <div class="trim-playhead" id="trim-playhead"></div>
                    <button
                      type="button"
                      class="trim-handle trim-handle-start"
                      id="trim-handle-start"
                      aria-label="Mover inicio del recorte"
                      title="Arrastra para ajustar el inicio"
                    ></button>
                    <button
                      type="button"
                      class="trim-handle trim-handle-end"
                      id="trim-handle-end"
                      aria-label="Mover término del recorte"
                      title="Arrastra para ajustar el término"
                    ></button>
                  </div>
                </div>

                <div class="trim-markers-bar">
                  <div class="trim-marker-item">
                    <button type="button" class="button small" id="trim-mark-start">Marcar inicio aquí</button>
                    <span class="tabular-cell">Inicio: <strong id="trim-start-readout">0:00</strong></span>
                  </div>
                  <div class="trim-marker-item">
                    <button type="button" class="button small" id="trim-mark-end">Marcar fin aquí</button>
                    <span class="tabular-cell">Fin: <strong id="trim-end-readout">0:00</strong></span>
                  </div>
                  <div class="trim-marker-summary">
                    <span class="tabular-cell">Duración: <strong id="trim-dur-readout">0:00</strong></span>
                    <button type="button" class="text-link small-preset" id="trim-reset-btn">Todo el bloque</button>
                  </div>
                </div>
              </div>

              <p id="clip-validation-error" class="clip-error" role="alert" hidden></p>

              <div class="clip-preview-strip">
                <div class="clip-filename-box">
                  <small>Archivo a descargar</small>
                  <strong id="clip-filename-preview">{defaultFilenamePreview}</strong>
                </div>
                <button type="submit" class="button primary" id="clip-download-btn">
                  <Icon name="down" size={16}/>
                  <span id="clip-download-label">Descargar MP3</span>
                </button>
              </div>
            </form>
          ) : (
            <p class="hint">Todavía no hay emisiones grabadas para recortar.</p>
          )}
        </div>
      </section>

      <!-- 2. Programas de la estación -->
      <section class="card">
        <div class="card-heading">
          <h2>Programas de la estación</h2>
          <span class="heading-meta">{programs.length} {programs.length === 1 ? 'programa' : 'programas'}</span>
        </div>

        <div class="card-body programs-body">
          {canEdit && (
            <form data-api-form={`/api/admin/radio/${channel.id}`} data-reload id="add-program-form" class="program-form">
              <input type="hidden" name="action" value="add-program"/>
              <input type="hidden" name="days" id="program-days-input" value="1,2,3,4,5"/>

              <div class="program-form-grid">
                <label class="prog-name-field">
                  Nombre del programa
                  <input name="name" class="field-input" maxlength="80" placeholder="Ej: Matinal Riquelme" required/>
                </label>
                <label>
                  Inicio
                  <input name="startTime" type="time" class="field-input" value="08:00" required/>
                </label>
                <label>
                  Término
                  <input name="endTime" type="time" class="field-input" value="12:00" required/>
                </label>
              </div>

              <div class="program-days-row">
                <div class="day-toggles" role="group" aria-label="Días de emisión">
                  {[
                    { d: 1, l: 'Lun' },
                    { d: 2, l: 'Mar' },
                    { d: 3, l: 'Mié' },
                    { d: 4, l: 'Jue' },
                    { d: 5, l: 'Vie' },
                    { d: 6, l: 'Sáb' },
                    { d: 0, l: 'Dom' },
                  ].map(({ d, l }) => (
                    <button
                      type="button"
                      class:list={['day-chip', d >= 1 && d <= 5 ? 'is-on' : '']}
                      data-day-toggle={d}
                      aria-pressed={d >= 1 && d <= 5 ? 'true' : 'false'}
                    >
                      {l}
                    </button>
                  ))}
                </div>
                <div class="day-presets">
                  <button type="button" class="text-link small-preset" data-day-preset="1,2,3,4,5">L–V</button>
                  <button type="button" class="text-link small-preset" data-day-preset="6,0">Finde</button>
                  <button type="button" class="text-link small-preset" data-day-preset="1,2,3,4,5,6,0">Todos</button>
                </div>
              </div>

              <div class="program-submit-row">
                <label class="check-label">
                  <input type="checkbox" name="overrideMetadata" checked/>
                  <span>Mostrar este nombre al aire en la página pública</span>
                </label>
                <button type="submit" class="button primary small">
                  <Icon name="plus" size={15}/>
                  Agregar
                </button>
              </div>
              <div data-form-result role="status" aria-live="polite"></div>
            </form>
          )}

          {programs.length ? (
            <div class="table-wrap programs-table-wrap">
              <table class="admin-compact-table">
                <thead>
                  <tr>
                    <th>Programa</th>
                    <th>Días</th>
                    <th>Horario</th>
                    <th>Al aire</th>
                    {canEdit && <th class="col-end"></th>}
                  </tr>
                </thead>
                <tbody>
                  {programs.map(prog => {
                    const isOnAir = liveStatus.activeProgram?.id === prog.id;
                    return (
                      <tr>
                        <td class="prog-name-cell">
                          <strong>{prog.name}</strong>
                          {isOnAir && <span class="badge green prog-live-badge">Al aire</span>}
                        </td>
                        <td class="nowrap-cell">{formatProgramDaysLabel(prog.days)}</td>
                        <td class="tabular-cell nowrap-cell">{prog.start_time} – {prog.end_time}</td>
                        <td class="nowrap-cell">
                          {canEdit ? (
                            <form data-api-form={`/api/admin/radio/${channel.id}`} data-reload class="inline-toggle-form">
                              <input type="hidden" name="action" value="toggle-program"/>
                              <input type="hidden" name="programId" value={prog.id}/>
                              <input type="hidden" name="overrideMetadata" value={prog.override_metadata ? '0' : '1'}/>
                              <button
                                type="submit"
                                class:list={['toggle-pill', prog.override_metadata ? 'is-on' : '']}
                                title="Cambiar si reemplaza el título en vivo"
                              >
                                {prog.override_metadata ? 'Reemplaza título' : 'Solo archivo'}
                              </button>
                            </form>
                          ) : (
                            <span class:list={['badge', prog.override_metadata ? 'blue' : 'gray']}>
                              {prog.override_metadata ? 'Reemplaza título' : 'Solo archivo'}
                            </span>
                          )}
                        </td>
                        {canEdit && (
                          <td class="prog-actions-cell">
                            <form data-api-form={`/api/admin/radio/${channel.id}`} data-reload>
                              <input type="hidden" name="action" value="delete-program"/>
                              <input type="hidden" name="programId" value={prog.id}/>
                              <button type="submit" class="button small" aria-label={`Eliminar ${prog.name}`}>
                                Eliminar
                              </button>
                            </form>
                          </td>
                        )}
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="hint empty-programs-note">
              Sin programas configurados. Agrégalos aquí para agrupar emisiones y etiquetar bloques automáticamente.
            </p>
          )}
        </div>
      </section>
    </div>

    <!-- COLUMNA DERECHA: Emisiones / Canciones + Configuración -->
    <div class="radio-admin-col">
      <!-- 3. Emisiones grabadas y canciones -->
      <section class="card">
        <div class="card-heading admin-tabs-heading">
          <div class="admin-tab-buttons" role="tablist">
            <button
              type="button"
              class="button small is-active-tab"
              role="tab"
              aria-selected="true"
              data-admin-tab="recordings"
            >
              Emisiones ({groupedEmissions.length})
            </button>
            <button
              type="button"
              class="button small"
              role="tab"
              aria-selected="false"
              data-admin-tab="songs"
            >
              Canciones ({recentSongs.length})
            </button>
          </div>

          <select id="admin-date-filter" class="select-field admin-date-filter" aria-label="Filtrar por fecha">
            <option value="">Todos los días</option>
            {days.map(d => (
              <option value={d}>{d === today ? `${d} (Hoy)` : d}</option>
            ))}
          </select>
        </div>

        <!-- Tab 1: Emisiones agrupadas -->
        <div class="card-body admin-list-panel" id="admin-tab-recordings">
          {groupedEmissions.length ? (
            <div class="table-wrap admin-scroll-table">
              <table class="admin-compact-table">
                <thead>
                  <tr>
                    <th>Emisión</th>
                    <th>Duración</th>
                    <th class="col-end">Acciones</th>
                  </tr>
                </thead>
                <tbody>
                  {groupedEmissions.map(rec => (
                    <tr data-filter-date={rec.dateStr}>
                      <td>
                        <strong class="emission-title">
                          {rec.programName || `${rec.startHhmm} – ${rec.endHhmm} hrs`}
                        </strong>
                        <small class="block-sub tabular-cell">
                          {rec.programName
                            ? `${rec.dateStr === today ? 'Hoy' : rec.dateStr} · ${rec.startHhmm} – ${rec.endHhmm} hrs`
                            : (rec.dateStr === today ? 'Hoy' : rec.dateStr)}
                        </small>
                      </td>
                      <td class="tabular-cell nowrap-cell">{rec.durationLabel}</td>
                      <td class="prog-actions-cell">
                        <div class="button-row compact-actions">
                          <button
                            type="button"
                            class="button small"
                            data-preview-group={rec.id}
                          >
                            <Icon name="play" size={13}/>
                            Escuchar
                          </button>
                          <button
                            type="button"
                            class="button small outline"
                            data-fill-clip
                            data-clip-group={rec.id}
                            data-clip-date={rec.dateStr}
                            data-clip-start={rec.startHhmm}
                            data-clip-prog={rec.programSlug}
                          >
                            Recortar
                          </button>
                        </div>
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="hint">Todavía no hay emisiones grabadas para este canal.</p>
          )}
        </div>

        <!-- Tab 2: Canciones reproducidas -->
        <div class="card-body admin-list-panel" id="admin-tab-songs" hidden>
          {recentSongs.length ? (
            <div class="table-wrap admin-scroll-table">
              <table class="admin-compact-table">
                <thead>
                  <tr>
                    <th>Hora</th>
                    <th>Canción</th>
                    <th>Duración</th>
                    <th class="col-end">Acción</th>
                  </tr>
                </thead>
                <tbody>
                  {recentSongs.map(song => (
                    <tr data-filter-date={song.dateStr}>
                      <td class="tabular-cell nowrap-cell">
                        <strong>{song.startHhmm}</strong>
                        <small class="block-sub">{song.dateStr === today ? 'Hoy' : song.dateStr}</small>
                      </td>
                      <td>
                        <div class="admin-song-cell">
                          {song.art && <img src={song.art} alt="" class="admin-song-thumb" loading="lazy"/>}
                          <div class="admin-song-text">
                            <strong>{song.title}</strong>
                            <small class="block-sub">{song.artist || stationInfo.name || channel.name}</small>
                          </div>
                        </div>
                      </td>
                      <td class="tabular-cell nowrap-cell">{formatSongDuration(song.duration)}</td>
                      <td class="prog-actions-cell">
                        {song.groupId ? (
                          <button
                            type="button"
                            class="button small outline"
                            data-fill-clip
                            data-clip-group={song.groupId}
                            data-clip-date={song.dateStr}
                            data-clip-start={song.startHhmm}
                            data-clip-offset={song.groupOffset}
                            data-clip-length={song.clipDur}
                            data-clip-prog={`${song.artist ? song.artist + ' ' : ''}${song.title}`}
                          >
                            Recortar
                          </button>
                        ) : (
                          <span class="muted small-muted">Sin corte</span>
                        )}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          ) : (
            <p class="hint">
              {apiUrl
                ? 'Aún no hay canciones registradas para esta emisora.'
                : 'Configura la URL de la API abajo para sincronizar canciones.'}
            </p>
          )}
        </div>
      </section>

      <!-- 4. Fuente de audio y publicación -->
      <section class="card radio-settings">
        <div class="card-heading">
          <h2>Fuente y publicación</h2>
          {stationInfo.name && <span class="badge green">API conectada</span>}
        </div>
        <div class="card-body radio-settings-body">
          {canEdit ? (
            <form data-api-form={`/api/admin/radio/${channel.id}`} data-reload>
              <div class="radio-config-fields">
                <label for="radio-station-api">URL de API de la estación (opcional)</label>
                <input
                  id="radio-station-api"
                  name="stationApi"
                  type="url"
                  class="field-input"
                  maxlength="2048"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder={defaultStationApiUrl}
                  value={apiUrl}
                />
                <p class="hint">
                  Sincroniza nombre, stream en vivo e historial musical (AzuraCast / StreamChileno).
                </p>

                <label for="radio-source">URL del stream en directo</label>
                <input
                  id="radio-source"
                  name="source"
                  type="url"
                  class="field-input"
                  maxlength="2048"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder={stationInfo.listen_url || 'https://cp.streamchileno.cl/radio/8040/radio.mp3'}
                  value={effectiveStream}
                />
                <p class="hint">
                  Si se deja en blanco con API activa, usa la dirección de transmisión entregada por la estación.
                </p>

                <div class="radio-checks-group">
                  <label class="radio-check">
                    <input type="checkbox" name="recording" checked={Boolean(settings?.recording)}/>
                    <span>Grabar continuamente (retención de 5 días)</span>
                  </label>
                  <label class="radio-check">
                    <input type="checkbox" name="published" checked={Boolean(settings?.published)}/>
                    <span>Publicar página de Radio a la carta</span>
                  </label>
                </div>
              </div>
              <div data-form-result role="status" aria-live="polite"></div>
              <div class="radio-save-row">
                <button class="button primary" type="submit">Guardar configuración</button>
                {stationInfo.url && (
                  <a class="text-link" href={stationInfo.url} target="_blank" rel="noopener noreferrer">
                    Sitio web <Icon name="external" size={14}/>
                  </a>
                )}
              </div>
            </form>
          ) : (
            <p class="hint">Solo un administrador puede modificar la fuente de audio y la publicación.</p>
          )}
        </div>
      </section>
    </div>
  </div>
</div>

<script>
  const clipForm = document.querySelector<HTMLFormElement>('#radio-clip-form');
  const emissionSelect = document.querySelector<HTMLSelectElement>('#clip-emission-select');
  const clipProg = document.querySelector<HTMLInputElement>('#clip-program');
  const clipPreview = document.querySelector<HTMLElement>('#clip-filename-preview');
  const clipError = document.querySelector<HTMLElement>('#clip-validation-error');
  const downloadBtn = document.querySelector<HTMLButtonElement>('#clip-download-btn');
  const downloadLabel = document.querySelector<HTMLElement>('#clip-download-label');

  const previewAudio = document.querySelector<HTMLAudioElement>('#admin-preview-audio');
  const playBtn = document.querySelector<HTMLButtonElement>('#trim-play-btn');
  const iconPlay = document.querySelector<HTMLElement>('#trim-icon-play');
  const iconPause = document.querySelector<HTMLElement>('#trim-icon-pause');
  const playLabel = document.querySelector<HTMLElement>('#trim-play-label');
  const back10Btn = document.querySelector<HTMLButtonElement>('#trim-back-10');
  const fwd10Btn = document.querySelector<HTMLButtonElement>('#trim-fwd-10');
  const previewSelBtn = document.querySelector<HTMLButtonElement>('#trim-preview-selection');
  const currentClock = document.querySelector<HTMLElement>('#trim-current-clock');
  const trimTrack = document.querySelector<HTMLElement>('#trim-track');
  const trimSelection = document.querySelector<HTMLElement>('#trim-selection');
  const trimPlayhead = document.querySelector<HTMLElement>('#trim-playhead');
  const handleStart = document.querySelector<HTMLButtonElement>('#trim-handle-start');
  const handleEnd = document.querySelector<HTMLButtonElement>('#trim-handle-end');
  const markStartBtn = document.querySelector<HTMLButtonElement>('#trim-mark-start');
  const markEndBtn = document.querySelector<HTMLButtonElement>('#trim-mark-end');
  const resetTrimBtn = document.querySelector<HTMLButtonElement>('#trim-reset-btn');
  const startReadout = document.querySelector<HTMLElement>('#trim-start-readout');
  const endReadout = document.querySelector<HTMLElement>('#trim-end-readout');
  const durReadout = document.querySelector<HTMLElement>('#trim-dur-readout');

  let totalDur = 0;
  let trimStart = 0;
  let trimEnd = 0;
  let stopAtTrimEnd = false;
  let draggingHandle: 'start' | 'end' | null = null;

  function fmtTime(seconds: number) {
    if (!Number.isFinite(seconds) || seconds < 0) return '0:00';
    const total = Math.floor(seconds);
    const hrs = Math.floor(total / 3600);
    const mins = Math.floor((total % 3600) / 60);
    const secs = total % 60;
    if (hrs > 0) return `${hrs}:${mins.toString().padStart(2, '0')}:${secs.toString().padStart(2, '0')}`;
    return `${mins}:${secs.toString().padStart(2, '0')}`;
  }

  function sanitizeSlug(val: string) {
    return (
      val
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toUpperCase()
        .replace(/[^A-Z0-9]+/g, '_')
        .replace(/^_+|_+$/g, '')
        .slice(0, 40) || 'PROGRAMA'
    );
  }

  function getSelectedOption() {
    return emissionSelect?.selectedOptions[0] || null;
  }

  function updateFilenamePreview() {
    const opt = getSelectedOption();
    if (!opt || !clipProg || !clipPreview) return;
    const d = opt.dataset.date || 'AAAA-MM-DD';
    const baseStart = (opt.dataset.start || '00:00').slice(0, 5);
    const p = sanitizeSlug(clipProg.value || 'PROGRAMA');
    clipPreview.textContent = `${d}_${baseStart}_${p}.MP3`;
    if (clipError) clipError.hidden = true;
  }

  function renderTrimmer() {
    const dur = Math.max(1, totalDur);
    const startPct = Math.max(0, Math.min(100, (trimStart / dur) * 100));
    const endPct = Math.max(startPct, Math.min(100, (trimEnd / dur) * 100));
    const cur = previewAudio && Number.isFinite(previewAudio.currentTime) ? previewAudio.currentTime : 0;
    const curPct = Math.max(0, Math.min(100, (cur / dur) * 100));

    if (trimSelection) {
      trimSelection.style.left = `${startPct}%`;
      trimSelection.style.width = `${Math.max(0.5, endPct - startPct)}%`;
    }
    if (handleStart) handleStart.style.left = `${startPct}%`;
    if (handleEnd) handleEnd.style.left = `${endPct}%`;
    if (trimPlayhead) trimPlayhead.style.left = `${curPct}%`;
    if (startReadout) startReadout.textContent = fmtTime(trimStart);
    if (endReadout) endReadout.textContent = fmtTime(trimEnd);
    if (durReadout) durReadout.textContent = fmtTime(Math.max(0, trimEnd - trimStart));
    if (currentClock) currentClock.textContent = `${fmtTime(cur)} / ${fmtTime(totalDur)}`;
  }

  function setPlayVisual(playing: boolean) {
    if (iconPlay) iconPlay.hidden = playing;
    if (iconPause) iconPause.hidden = !playing;
    if (playLabel) playLabel.textContent = playing ? 'Pausar' : 'Escuchar';
  }

  function loadSelectedEmission(options?: { offset?: number; length?: number; autoPlay?: boolean; customProgram?: string }) {
    const opt = getSelectedOption();
    if (!opt || !previewAudio) return;
    const audioUrl = opt.dataset.audio || '';
    const declaredDur = Math.max(1, Number(opt.dataset.duration) || 60);
    totalDur = declaredDur;

    const desiredStart = options?.offset !== undefined ? Math.max(0, Math.min(options.offset, totalDur - 2)) : 0;
    const desiredEnd = options?.length !== undefined
      ? Math.max(desiredStart + 2, Math.min(totalDur, desiredStart + options.length))
      : totalDur;
    trimStart = desiredStart;
    trimEnd = desiredEnd;
    stopAtTrimEnd = false;

    if (clipProg) {
      clipProg.value = options?.customProgram || opt.dataset.program || '';
    }
    updateFilenamePreview();
    renderTrimmer();

    if (previewAudio.getAttribute('src') !== audioUrl) {
      previewAudio.src = audioUrl;
      previewAudio.load();
    }
    const seekAndPlay = () => {
      try {
        if (desiredStart > 0) previewAudio.currentTime = desiredStart;
      } catch {}
      renderTrimmer();
      if (options?.autoPlay) void previewAudio.play().catch(() => {});
    };
    if (previewAudio.readyState >= 1) {
      seekAndPlay();
    } else {
      previewAudio.addEventListener('loadedmetadata', seekAndPlay, { once: true });
    }
  }

  if (emissionSelect && previewAudio) {
    const initOpt = getSelectedOption();
    totalDur = Math.max(1, Number(initOpt?.dataset.duration) || 60);
    trimStart = 0;
    trimEnd = totalDur;
    renderTrimmer();
    updateFilenamePreview();

    emissionSelect.addEventListener('change', () => loadSelectedEmission());
    clipProg?.addEventListener('input', updateFilenamePreview);

    previewAudio.addEventListener('loadedmetadata', () => {
      if (Number.isFinite(previewAudio.duration) && previewAudio.duration > 1) {
        const wasFull = Math.abs(trimEnd - totalDur) < 2;
        totalDur = previewAudio.duration;
        if (wasFull || trimEnd > totalDur) trimEnd = totalDur;
        if (trimStart >= trimEnd) trimStart = Math.max(0, trimEnd - 5);
        renderTrimmer();
      }
    });
    previewAudio.addEventListener('play', () => setPlayVisual(true));
    previewAudio.addEventListener('pause', () => {
      setPlayVisual(false);
      stopAtTrimEnd = false;
    });
    previewAudio.addEventListener('timeupdate', () => {
      if (stopAtTrimEnd && previewAudio.currentTime >= trimEnd) {
        previewAudio.pause();
        stopAtTrimEnd = false;
      }
      renderTrimmer();
    });

    playBtn?.addEventListener('click', () => {
      stopAtTrimEnd = false;
      if (previewAudio.paused) void previewAudio.play().catch(() => {});
      else previewAudio.pause();
    });
    back10Btn?.addEventListener('click', () => {
      previewAudio.currentTime = Math.max(0, previewAudio.currentTime - 10);
      renderTrimmer();
    });
    fwd10Btn?.addEventListener('click', () => {
      previewAudio.currentTime = Math.min(totalDur, previewAudio.currentTime + 10);
      renderTrimmer();
    });
    previewSelBtn?.addEventListener('click', () => {
      stopAtTrimEnd = true;
      previewAudio.currentTime = trimStart;
      void previewAudio.play().catch(() => {});
      renderTrimmer();
    });
    markStartBtn?.addEventListener('click', () => {
      const cur = previewAudio.currentTime || 0;
      trimStart = Math.max(0, Math.min(cur, trimEnd - 2));
      renderTrimmer();
    });
    markEndBtn?.addEventListener('click', () => {
      const cur = previewAudio.currentTime || totalDur;
      trimEnd = Math.min(totalDur, Math.max(cur, trimStart + 2));
      renderTrimmer();
    });
    resetTrimBtn?.addEventListener('click', () => {
      trimStart = 0;
      trimEnd = totalDur;
      renderTrimmer();
    });

    function secFromPointer(clientX: number) {
      if (!trimTrack) return 0;
      const rect = trimTrack.getBoundingClientRect();
      const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / Math.max(1, rect.width)));
      return ratio * totalDur;
    }

    handleStart?.addEventListener('pointerdown', e => {
      e.stopPropagation();
      draggingHandle = 'start';
      handleStart.setPointerCapture(e.pointerId);
    });
    handleEnd?.addEventListener('pointerdown', e => {
      e.stopPropagation();
      draggingHandle = 'end';
      handleEnd.setPointerCapture(e.pointerId);
    });
    window.addEventListener('pointermove', e => {
      if (!draggingHandle) return;
      const sec = secFromPointer(e.clientX);
      if (draggingHandle === 'start') {
        trimStart = Math.max(0, Math.min(sec, trimEnd - 2));
      } else {
        trimEnd = Math.min(totalDur, Math.max(sec, trimStart + 2));
      }
      renderTrimmer();
    });
    window.addEventListener('pointerup', () => {
      draggingHandle = null;
    });
    trimTrack?.addEventListener('click', e => {
      if (draggingHandle || (e.target as Element).closest('.trim-handle')) return;
      const sec = secFromPointer(e.clientX);
      try {
        previewAudio.currentTime = sec;
      } catch {}
      renderTrimmer();
    });
  }

  // AJAX MP3 download with real error handling & progress state
  clipForm?.addEventListener('submit', async event => {
    event.preventDefault();
    const opt = getSelectedOption();
    const endpoint = clipForm.dataset.clipEndpoint || '';
    if (!opt || !endpoint) return;
    const clipLen = Math.max(0, trimEnd - trimStart);
    if (clipLen < 2) {
      if (clipError) {
        clipError.textContent = 'El recorte debe durar al menos 2 segundos.';
        clipError.hidden = false;
      }
      return;
    }
    if (clipError) clipError.hidden = true;
    if (downloadBtn) downloadBtn.disabled = true;
    if (downloadLabel) downloadLabel.textContent = 'Generando MP3…';

    try {
      const params = new URLSearchParams({
        action: 'clip',
        date: opt.dataset.date || '',
        grupo: opt.value,
        offsetSec: trimStart.toFixed(2),
        durationSec: clipLen.toFixed(2),
        start: opt.dataset.start || '00:00',
        program: clipProg?.value.trim() || opt.dataset.program || 'PROGRAMA',
      });
      const res = await fetch(`${endpoint}?${params.toString()}`);
      if (!res.ok) {
        const msg = (await res.text()).trim() || 'No se pudo generar el archivo MP3.';
        throw new Error(msg);
      }
      const blob = await res.blob();
      const dlUrl = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = dlUrl;
      link.download = (clipPreview?.textContent || 'recorte.mp3').replace(/:/g, '_');
      document.body.append(link);
      link.click();
      link.remove();
      setTimeout(() => URL.revokeObjectURL(dlUrl), 10_000);
    } catch (err) {
      if (clipError) {
        clipError.textContent = err instanceof Error ? err.message : 'No se pudo descargar el recorte MP3.';
        clipError.hidden = false;
      }
    } finally {
      if (downloadBtn) downloadBtn.disabled = false;
      if (downloadLabel) downloadLabel.textContent = 'Descargar MP3';
    }
  });

  // Day chip toggles for adding a program
  const daysInput = document.querySelector<HTMLInputElement>('#program-days-input');
  const dayChips = [...document.querySelectorAll<HTMLButtonElement>('[data-day-toggle]')];

  function syncDaysInput() {
    if (!daysInput) return;
    const active = dayChips
      .filter(btn => btn.classList.contains('is-on'))
      .map(btn => btn.dataset.dayToggle);
    daysInput.value = active.join(',');
  }

  dayChips.forEach(btn => {
    btn.addEventListener('click', () => {
      const on = !btn.classList.contains('is-on');
      btn.classList.toggle('is-on', on);
      btn.setAttribute('aria-pressed', String(on));
      syncDaysInput();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('[data-day-preset]').forEach(presetBtn => {
    presetBtn.addEventListener('click', () => {
      const set = new Set((presetBtn.dataset.dayPreset || '').split(','));
      dayChips.forEach(chip => {
        const on = set.has(chip.dataset.dayToggle || '');
        chip.classList.toggle('is-on', on);
        chip.setAttribute('aria-pressed', String(on));
      });
      syncDaysInput();
    });
  });

  // Tabs switching (Emisiones vs Canciones)
  const tabBtns = [...document.querySelectorAll<HTMLButtonElement>('[data-admin-tab]')];
  const tabRecordings = document.querySelector<HTMLElement>('#admin-tab-recordings');
  const tabSongs = document.querySelector<HTMLElement>('#admin-tab-songs');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.adminTab;
      tabBtns.forEach(b => {
        const active = b === btn;
        b.classList.toggle('is-active-tab', active);
        b.setAttribute('aria-selected', String(active));
      });
      if (tabRecordings) tabRecordings.hidden = target !== 'recordings';
      if (tabSongs) tabSongs.hidden = target !== 'songs';
    });
  });

  // Date filter for Emisiones & Canciones
  const dateFilter = document.querySelector<HTMLSelectElement>('#admin-date-filter');
  dateFilter?.addEventListener('change', () => {
    const selected = dateFilter.value;
    document.querySelectorAll<HTMLTableRowElement>('tr[data-filter-date]').forEach(row => {
      row.hidden = Boolean(selected && row.dataset.filterDate !== selected);
    });
  });

  // Load any emission or song into the interactive trimmer
  document.addEventListener('click', event => {
    const target = event.target as Element;

    const previewBtn = target.closest<HTMLButtonElement>('[data-preview-group]');
    if (previewBtn && emissionSelect) {
      const groupId = previewBtn.dataset.previewGroup || '';
      if (groupId) {
        emissionSelect.value = groupId;
        loadSelectedEmission({ autoPlay: true });
        document.querySelector('#radio-clip-form')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return;
    }

    const fillBtn = target.closest<HTMLButtonElement>('[data-fill-clip]');
    if (fillBtn && emissionSelect) {
      const groupId = fillBtn.dataset.clipGroup || '';
      if (groupId) emissionSelect.value = groupId;
      const offset = fillBtn.dataset.clipOffset ? Number(fillBtn.dataset.clipOffset) : undefined;
      const length = fillBtn.dataset.clipLength ? Number(fillBtn.dataset.clipLength) : undefined;
      loadSelectedEmission({
        offset,
        length,
        autoPlay: false,
        customProgram: fillBtn.dataset.clipProg || undefined,
      });
      document.querySelector('#radio-clip-form')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }
  });
</script>

