# Local development only. The VPS installer writes its own .env with random secrets.
APP_ORIGIN=http://127.0.0.1:4321
MEDIA_ORIGIN=https://media.example.test
INGEST_HOST=ingest.example.test
DATA_DIR=./data
# Generate using openssl rand -hex 32; do not reuse these values.
OME_API_TOKEN=
OME_ADMISSION_SECRET=
PROXY_SECRET=

OME_WORKER_SECRET=
# Optional: defaults are 5 GiB per owner and 1 GiB per normalized video.
STORAGE_QUOTA_BYTES=5368709120
MAX_OUTPUT_BYTES=1073741824
