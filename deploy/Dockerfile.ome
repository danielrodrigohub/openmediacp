ARG OME_BASE_IMAGE=ovenmedialabs/ovenmediaengine:v0.21.0
FROM ${OME_BASE_IMAGE}
USER root
# Refresh the distribution's OpenSSL packages: the upstream v0.21.0 image ships
# libssl3 3.0.2-0ubuntu1.26, reported for CVE-2026-84782 by Trivy.
RUN apt-get update && apt-get install -y --no-install-recommends --only-upgrade libssl3 openssl && rm -rf /var/lib/apt/lists/*
